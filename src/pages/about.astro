---
import { CALENDLY_URL } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { LINKEDIN_URL, EMAIL } from '../config';
import { talks } from '../data/proof';
---

<BaseLayout
  title="About & Experience | Frankly Inspired"
  description="Franklin D. Parham's background, experience, and impact in nonprofit leadership, fundraising, and organizational sustainability."
  footerVariant="about"
>
  <Header variant="full" />

  <main id="main">

    <!-- ============ ABOUT: dark stage hero ============ -->
    <section class="about-stage" aria-labelledby="about-name">
      <div class="stage-glow stage-glow-gold" aria-hidden="true"></div>
      <div class="stage-glow stage-glow-blue" aria-hidden="true"></div>
      <div class="stage-grid" aria-hidden="true"></div>
      <div class="container stage-inner">
        <div class="stage-text">
          <p class="stage-eyebrow stage-in" style="--d:0ms">About</p>
          <h1 id="about-name" class="stage-name stage-in" style="--d:120ms">Franklin D.<br />Parham</h1>
          <p class="stage-role stage-in" style="--d:260ms">Founder &amp; Principal, Frankly Inspired and Associates</p>
          <p class="stage-lede stage-in" style="--d:380ms">I help nonprofit leaders know what to build next, what it costs, and how to fund it.</p>
          <ul class="stage-facts stage-in" style="--d:520ms">
            <li><strong>20+ years</strong><span>education, advancement and nonprofit leadership</span></li>
            <li><strong>Two-city region</strong><span>Regional Director, The Hidden Genius Project</span></li>
            <li><strong>90 days</strong><span>to close the gap that will break first</span></li>
          </ul>
        </div>
        <picture class="stage-portrait">
          <source srcset="/assets/images/franklin-parham-portrait-dark.webp" type="image/webp" />
          <img src="/assets/images/franklin-parham-portrait-dark.png" alt="Franklin D. Parham, Founder and Principal of Frankly Inspired and Associates" width="738" height="1064" loading="eager" fetchpriority="high" />
        </picture>
      </div>
    </section>

    <!-- ============ Statement that lights up as you scroll ============ -->
    <section class="about-statement" aria-label="In short">
      <div class="container">
        <p class="lit-text" data-lit>I've raised the money, run the region and built the systems myself. Now I help growing nonprofits find the one gap that will break first, and close it before it does.</p>
      </div>
    </section>

    <section id="about" class="section about about-body">
      <div class="container about-col">
        <div class="about-intro reveal">
          <picture class="about-headshot">
            <source srcset="/assets/images/franklin-parham-headshot-color.webp" type="image/webp" />
            <img src="/assets/images/franklin-parham-headshot-color.jpg" alt="Franklin D. Parham" width="936" height="840" loading="lazy" />
          </picture>
          <div>
            <p class="about-intro-eyebrow">Who I am</p>
            <p class="about-intro-lead">I've spent more than 20 years in education, fundraising and nonprofit leadership, on both the program side and the money side.</p>
          </div>
        </div>
        <p class="reveal">I grew up in Alabama and studied at Alabama State University, where I earned a B.A. in English and Communications and an M.Ed. in English Education. My first jobs were with students: the university's Reading and Learning Lab and Educational Teaching and Learning Lab, then residential life and TRIO Upward Bound.</p>
        <p class="reveal">From there I moved into fundraising and advancement: institutional advancement at Brandeis University, donor relations at George Washington University, and fundraising and development at the Society of American Foresters.</p>
        <p class="reveal">Most recently I was Regional Director for The Hidden Genius Project's Mid-Atlantic region, running Baltimore and Philadelphia: the budget, staff, partners, recruitment, and the systems behind them. I also helped build the national alumni engagement model, including its KPIs and Salesforce setup.</p>
        <p class="reveal">What I learned is that good programs aren't enough. When a nonprofit grows, the strain shows up in the board, the books, the data, and in how many decisions still wait on one person. Frankly Inspired is how I help leaders fix that before it breaks.</p>
      </div>
    </section>

    <!-- ============ PHILOSOPHY / POINT OF VIEW ============ -->
    <section class="section philosophy">
      <div class="container narrow">
        <blockquote class="reveal">
          Strong programs need an organization strong enough to carry them.
        </blockquote>
      </div>
    </section>

    <!-- ============ EXPERIENCE AND IMPACT ============ -->
    <section id="experience" class="section experience">
      <div class="container">
        <h2 class="section-title reveal">Experience &amp; Impact</h2>

        <h3 class="subhead reveal">Impact by the Numbers</h3>
        <p class="section-note reveal">Metrics reflect Franklin's most recent regional leadership role.</p>
        <div class="stat-grid">
          <div class="stat reveal"><span class="stat-num">400+</span><span class="stat-label">youth and families served through Mid-Atlantic regional leadership</span></div>
          <div class="stat reveal"><span class="stat-num">$1.3M</span><span class="stat-label">in combined regional operating budgets managed</span></div>
          <div class="stat reveal"><span class="stat-num">20+</span><span class="stat-label">corporate, philanthropic, educational, workforce, government, and community partnerships built and stewarded</span></div>
          <div class="stat reveal"><span class="stat-num">200+</span><span class="stat-label">student applicants generated through regional recruitment systems</span></div>
          <div class="stat reveal"><span class="stat-num">60+</span><span class="stat-label">volunteers, mentors, educators, and industry professionals mobilized</span></div>
          <div class="stat reveal"><span class="stat-num">100%</span><span class="stat-label">college enrollment among the referenced graduating senior cohort, with more than $500,000 collectively secured in scholarships and financial aid</span></div>
        </div>

        <h3 class="subhead reveal">Featured Experience: The Hidden Genius Project</h3>
        <p class="role-meta reveal">Regional Director, Mid-Atlantic Region (Baltimore and Philadelphia), April 2025 to June 2026</p>
        <!-- Bullets describe the work itself rather than repeating the figures
             already shown in "Impact by the Numbers" above. -->
        <ul class="bullet-list reveal">
          <li>Led multi-site regional operations across Baltimore and Philadelphia, owning programming, staffing, and day-to-day execution.</li>
          <li>Held full financial stewardship for the region, from budget planning through reporting to funders and leadership.</li>
          <li>Developed sustainability strategies using Community Partnership Programming, corporate partnerships, foundation grants, and state and federal funding opportunities.</li>
          <li>Negotiated and established a strategic facility partnership and MOU with the Philadelphia Youth Basketball 6th Man Center.</li>
          <li>Built and stewarded a cross-sector ecosystem spanning corporate, philanthropic, education, workforce, and government partners.</li>
          <li>Recruited, trained, and coordinated a network of volunteers, mentors, educators, and industry professionals supporting program delivery.</li>
          <li>Designed and ran recruitment systems that expanded the applicant pipeline region-wide.</li>
          <li>Helped strengthen national alumni-engagement operations through KPI frameworks, Salesforce data governance, engagement tracking, and systems design.</li>
        </ul>

        <h3 class="subhead reveal">Earlier Career, by the Numbers</h3>
        <div class="stat-grid">
          <div class="stat reveal"><span class="stat-num">~700</span><span class="stat-label">leadership and planned gift prospects managed in Brandeis University's advancement database</span></div>
          <div class="stat reveal"><span class="stat-num">550</span><span class="stat-label">residents in the residence hall Franklin directed at Alabama State University, with its budget and staff</span></div>
        </div>

        <h3 class="subhead reveal">Earlier Leadership</h3>
        <ul class="bullet-list reveal">
          <li><strong>Alumni Engagement Coordinator, The Hidden Genius Project (Atlanta and Baltimore).</strong> Led alumni data collection and analysis to inform program decisions, onboarded college-access partners such as Beyond 12, and trained staff and volunteers on program methods.</li>
          <li><strong>Manager, Fundraising &amp; Development, Society of American Foresters.</strong> Built the annual fundraising budget, goals, and out-year projections with the CEO, strengthened donor retention, managed the Founder's Circle pledge campaign, and served as liaison to the Revenue Development committee.</li>
          <li><strong>Assistant Director, Donor Relations, George Washington University (School of Engineering and Applied Science).</strong> Identified leadership-level prospects from giving patterns, staffed the dean's Board of Advisors meetings, and built the alumni engagement pipeline.</li>
          <li><strong>Senior Department Coordinator, Institutional Advancement, Brandeis University.</strong> Managed a database of about 700 gift prospects, shaped campaign strategy around gift officers' portfolios, and prepared proposals, stewardship reports, and gift agreements for leadership and planned gifts. Also worked in student affairs partnerships and international admissions.</li>
          <li><strong>Researcher and Senior Department Coordinator, Wentworth Institute of Technology.</strong> Expanded research grants and community partners with the Center for Community and Learning Partnerships, and prepared Board of Trustees materials and financial analysis for the CFO's office.</li>
          <li><strong>Reading and Learning Lab and Educational Teaching and Learning Lab, Alabama State University (as an undergraduate).</strong> Supported student development, retention, and leadership, the start of more than 20 years of work in education and institution building.</li>
          <li><strong>Instructor and Counselor, TRIO Upward Bound; Residential Life Supervisor, Alabama State University; Assistant General Manager, American Campus Communities at Clark Atlanta University.</strong> Taught and counseled students, tracked their progress, and ran facilities, budgets, and staff teams.</li>
        </ul>

        <h3 class="subhead reveal">Board Leadership &amp; Affiliations</h3>
        <ul class="bullet-list two-col reveal">
          <li>Strategic Fundraising Advisor, Ora Lee Smith Cancer Research Foundation</li>
          <li>Board Advisor, Turner Foundation for Community Advocacy</li>
          <li>Fellow, Howard Rye Institute, Class of 2017</li>
          <li>Fellow, Association of Fundraising Professionals, Massachusetts Chapter, Class of 2017</li>
        </ul>
      </div>
    </section>

    <!-- ============ SPEAKING AND OPPORTUNITY ============ -->
    <section id="speaking" class="section speaking alt-bg">
      <div class="container">
        <h2 class="section-title reveal">Speaking &amp; Board Service</h2>
        <p class="section-note reveal">Franklin speaks with nonprofit boards, staff teams, and sector convenings, and is open to selected board service and advisory roles.</p>
        <h3 class="subhead reveal">Topics</h3>
        <div class="card-grid">
          <div class="card card-static reveal">
            <h4>Find the Gap That Breaks First</h4>
            <p>Why most organizations work on the wrong problem, and how to find the gap that will break first.</p>
          </div>
          <div class="card card-static reveal">
            <h4>Beyond the First Gift</h4>
            <p>Donor retention, monthly giving, and planned giving: where steady revenue comes from.</p>
          </div>
          <div class="card card-static reveal">
            <h4>Building Institutions That Outlast Their Founders</h4>
            <p>Leadership bench strength, succession planning, and the systems that keep an organization running through transition.</p>
          </div>
          <div class="card card-static reveal">
            <h4>Cross-Sector Partnerships That Last</h4>
            <p>Building and stewarding education, workforce, corporate, government, and philanthropic partnerships that sustain programs.</p>
          </div>
        </div>
        <p class="reveal" style="margin-top:1.25rem;"><strong>Formats:</strong> keynotes, workshops, panels, and board or staff retreats.</p>
        {talks.length > 0 && (
          <>
            <h3 class="subhead reveal">Recent Engagements</h3>
            <ul class="bullet-list reveal">
              {talks.map((t) => <li><strong>{t.title}</strong>, {t.event}{t.date && <>, {t.date}</>}</li>)}
            </ul>
          </>
        )}
        <a class="btn btn-secondary reveal" href="/#contact" data-track="speaking_inquiry">Invite Franklin to Speak</a>
      </div>
    </section>

    <!-- ============ RESUME ============ -->
    <section id="resume" class="section resume">
      <div class="container narrow center">
        <h2 class="section-title reveal">Resume</h2>
        <p class="reveal">Franklin's full work history is on LinkedIn, and a complete resume is available on request.</p>
        <div class="hero-ctas center reveal">
          <a class="btn btn-secondary" href={LINKEDIN_URL} target="_blank" rel="noopener" data-track="linkedin_click">View on LinkedIn</a>
          <a class="btn btn-secondary" href={`mailto:${EMAIL}?subject=Resume%20Request`} data-track="resume_request">Request the Resume</a>
        </div>
      </div>
    </section>

    <!-- ============ CLOSING CTA ============ -->
    <!-- This page dead-ends otherwise, anyone who's read this far is a
         warm lead, so send them back into the funnel rather than leaving
         them with only the footer. -->
    <section class="section closing-cta">
      <div class="container narrow center">
        <h2 class="reveal">Facing a decision about growth?</h2>
        <p class="reveal">A second site, a bigger grant, a leadership change: tell me what's coming. In 30 minutes we can tell whether a Diagnostic is the right next step.</p>
        <a class="btn btn-primary reveal" href={CALENDLY_URL} target="_blank" rel="noopener">Schedule a Conversation</a>
        <p style="margin-top: 1rem;"><a class="link-more" href="/consulting">See services and pricing</a></p>
      </div>
    </section>

  </main>

  <ScrollReveal />
  <script>
    // Word-by-word light-up as the statement crosses the viewport. Off for reduced motion.
    const lit = document.querySelector<HTMLElement>('[data-lit]');
    if (lit && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const words = lit.textContent!.trim().split(/\s+/);
      lit.innerHTML = words.map((w) => `<span class="lit-w">${w}</span>`).join(' ');
      lit.classList.add('lit-ready');
      const spans = Array.from(lit.querySelectorAll<HTMLElement>('.lit-w'));
      let ticking = false;
      const update = () => {
        ticking = false;
        const r = lit.getBoundingClientRect(), vh = window.innerHeight;
        // 0 when the block's top reaches 85% of the screen, 1 when its bottom reaches 45%.
        const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height + vh * 0.4)));
        const n = Math.round(p * spans.length);
        spans.forEach((s, i) => s.classList.toggle('on', i < n));
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      addEventListener('resize', update);
      update();
    }
  </script>
</BaseLayout>
