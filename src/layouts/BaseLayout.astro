---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import CookieConsentBanner from '../components/CookieConsentBanner.astro';
import Analytics from '../components/Analytics.astro';
import { SITE_URL, EMAIL, PHONE_TEL, LINKEDIN_URL } from '../config';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  robotsNoindex?: boolean;
  footerVariant?: 'home' | 'about' | 'assessment' | 'legal' | 'score';
}

const { title, description, bodyClass, robotsNoindex = false, footerVariant = 'home' } = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE_URL).href;
const ogImage = SITE_URL + '/assets/images/franklin-parham-headshot.jpg';

// Structured data so search engines understand who this is and where they
// work (shows up in rich results and local search).
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': SITE_URL + '/#business',
      name: 'Frankly Inspired and Associates, LLC',
      url: SITE_URL,
      email: EMAIL,
      telephone: PHONE_TEL,
      image: ogImage,
      description: 'Nonprofit strategy and sustainability consulting: evidence-based diagnostics, revenue and fundraising strategy, leadership and operations advising.',
      address: { '@type': 'PostalAddress', addressLocality: 'Lanham', addressRegion: 'MD', addressCountry: 'US' },
      areaServed: ['Washington DC metropolitan area', 'Maryland', 'Virginia', 'United States'],
      founder: { '@id': SITE_URL + '/#franklin' },
      priceRange: '$350 to $3,500',
    },
    {
      '@type': 'Person',
      '@id': SITE_URL + '/#franklin',
      name: 'Franklin D. Parham',
      jobTitle: 'Founder and Principal',
      worksFor: { '@id': SITE_URL + '/#business' },
      url: SITE_URL + '/about',
      sameAs: [LINKEDIN_URL],
      alumniOf: 'Alabama State University',
    },
  ],
};
---

<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <!-- Flips no-js -> js immediately so CSS can gate the scroll-reveal
         effect behind confirmed JS support (see .reveal in global.css).
         If JS is off, this never runs and content just stays visible. -->
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robotsNoindex && <meta name="robots" content="noindex" />}
    {!robotsNoindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Frankly Inspired and Associates" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to main content</a>

    <slot />

    <Footer variant={footerVariant} />
    <CookieConsentBanner />
    <Analytics />

    <script>
      import { enableInlineBooking } from '../scripts/booking';
      enableInlineBooking();
    </script>
    <script>
      // Exposes the sticky header's real rendered height as --header-height,
      // since it isn't a fixed number: the minimal header (assessment/
      // privacy/terms) can wrap to 2-3 rows on narrow phones, and the full
      // header's row height differs slightly by breakpoint. Anything that
      // needs to sit "just below the header" (assessment's sticky progress
      // bar) reads this instead of a guessed fixed offset.
      function setHeaderHeightVar() {
        const header = document.querySelector<HTMLElement>('.site-header');
        if (!header) return;
        document.documentElement.style.setProperty('--header-height', header.getBoundingClientRect().height + 'px');
      }
      setHeaderHeightVar();
      window.addEventListener('resize', setHeaderHeightVar);
      if ('ResizeObserver' in window) {
        const header = document.querySelector('.site-header');
        if (header) new ResizeObserver(setHeaderHeightVar).observe(header);
      }
    </script>
  </body>
</html>
