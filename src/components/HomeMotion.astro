---
// Homepage motion: headline word rise, speech-bubble
// pops, scroll-scrubbed text, drifting card rows, and number count-ups.
// CSS lives under "Homepage motion" in global.css. Everything is skipped
// for visitors who prefer reduced motion, and every effect leaves the
// final, readable state in the HTML so nothing depends on this script.
---

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- Split text into word spans (keeps links and other markup) ----------
  function splitWords(root: HTMLElement, wrap: (word: string, i: number) => HTMLElement) {
    let i = 0;
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const nodes: Text[] = [];
    while (walker.nextNode()) nodes.push(walker.currentNode as Text);
    nodes.forEach((node) => {
      const parts = (node.textContent || '').split(/(\s+)/);
      const frag = document.createDocumentFragment();
      parts.forEach((p) => {
        if (!p) return;
        if (/^\s+$/.test(p)) frag.appendChild(document.createTextNode(p));
        else frag.appendChild(wrap(p, i++));
      });
      node.replaceWith(frag);
    });
    return i;
  }

  const inView = (el: Element, cb: () => void, threshold = 0.2) => {
    if (!('IntersectionObserver' in window)) { cb(); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { cb(); io.disconnect(); } });
    }, { threshold });
    io.observe(el);
  };

  if (!reduce) {
    // Headline: each word rises out of a mask.
    document.querySelectorAll<HTMLElement>('[data-split]').forEach((el) => {
      el.setAttribute('aria-label', el.textContent?.trim() || '');
      splitWords(el, (word, i) => {
        const outer = document.createElement('span');
        outer.className = 'w';
        outer.setAttribute('aria-hidden', 'true');
        const inner = document.createElement('span');
        inner.textContent = word;
        outer.style.setProperty('--i', String(i));
        outer.appendChild(inner);
        return outer;
      });
      el.classList.add('split-line');
      requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-in')));
    });

    // Speech bubbles.
    document.querySelectorAll<HTMLElement>('.pop').forEach((el) => inView(el, () => el.classList.add('is-in'), 0.4));

    // Scroll-scrubbed text: words ink in as the paragraph moves up the screen.
    const scrubs = Array.from(document.querySelectorAll<HTMLElement>('.scrub')).map((el) => {
      const words: HTMLElement[] = [];
      splitWords(el, (word) => {
        const s = document.createElement('span');
        s.className = 'sw';
        s.textContent = word;
        words.push(s);
        return s;
      });
      return { el, words };
    });

    // Drifting rows: cards in alternating rows slide opposite ways.
    const drifters = Array.from(document.querySelectorAll<HTMLElement>('[data-drift]'));

    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;

      scrubs.forEach(({ el, words }) => {
        const r = el.getBoundingClientRect();
        if (r.bottom < -50 || r.top > vh + 50) return;
        // 0 when the top hits 88% of the screen, 1 when the bottom reaches 45%.
        const start = vh * 0.88, end = vh * 0.45;
        const p = Math.min(1, Math.max(0, (start - r.top) / (start - end + r.height * 0.6)));
        const lit = Math.round(p * words.length);
        words.forEach((w, i) => w.classList.toggle('on', i < lit));
      });

      const wide = window.innerWidth >= 900;
      drifters.forEach((grid) => {
        const r = grid.getBoundingClientRect();
        const kids = Array.from(grid.children) as HTMLElement[];
        if (!wide) { kids.forEach((k) => k.style.removeProperty('--drift')); return; }
        if (r.bottom < 0 || r.top > vh) return;
        const p = (vh - r.top) / (vh + r.height); // 0..1 across the pass
        const amt = (p - 0.5) * 70;
        const firstTop = kids[0]?.offsetTop ?? 0;
        kids.forEach((k) => {
          const row = k.offsetTop > firstTop + 4 ? 1 : 0;
          k.style.setProperty('--drift', `${row ? -amt : amt}px`);
        });
      });

    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();

    // Numbers count up to their real value when they come into view.
    document.querySelectorAll<HTMLElement>('[data-count] .stat-num, .stat-num[data-count]').forEach((el) => {
      const final = el.textContent || '';
      const m = final.match(/^([^\d]*)([\d.,]+)(.*)$/);
      if (!m) return;
      const [, pre, numStr, post] = m;
      const target = parseFloat(numStr.replace(/,/g, ''));
      const decimals = (numStr.split('.')[1] || '').length;
      if (!isFinite(target)) return;
      el.textContent = pre + (0).toFixed(decimals) + post;
      inView(el, () => {
        const t0 = performance.now(), dur = 1400;
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / dur);
          const eased = 1 - Math.pow(1 - k, 3);
          el.textContent = k < 1 ? pre + (target * eased).toFixed(decimals) + post : final;
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }, 0.5);
    });
  }
</script>
