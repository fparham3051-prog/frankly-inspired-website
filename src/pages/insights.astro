---
import { CALENDLY_URL } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import DurabilityIndex from '../components/DurabilityIndex.astro';
import HomeMotion from '../components/HomeMotion.astro';

// Field notes: Franklin's own observations, in one format every time:
// the signal a leader notices, what organizations usually assume, the
// constraint it often turns out to be, the evidence to check, and the
// first 90-day action. Add new notes at the top.
const fieldNotes = [
  {
    id: 'more-staff-more-strain',
    title: 'More staff, more strain',
    signal: 'The executive director is working longer hours, even after new hires.',
    assumption: 'The organization needs more people.',
    constraint: 'Decisions still run through one person. New staff add questions, not capacity.',
    evidence: 'Which approvals land on the ED each week, who owns each workflow, and whether roles say what each person can decide alone.',
    action: 'List the ten approvals the ED makes most often and write down who decides each one from now on. Revisit the list in 30 days.',
    trigger: 'founder',
    tool: { href: '/leadership-health', label: 'Score your leadership and operations' },
  },
  {
    id: 'second-site-test',
    title: 'The second-site test',
    signal: 'The first site has a waitlist, so leadership plans a second site or city.',
    assumption: 'The second site needs a site lead and new funding.',
    constraint: "The first site's success lives in people's heads: how recruitment works, what partners agreed to, what a site really costs.",
    evidence: 'Is there a written recruitment calendar, a partner agreement template, and a site budget model someone else could run?',
    action: "Before hiring for site two, write site one's playbook: recruitment steps and dates, a standard partner agreement or MOU, and a budget template. Then test it by having someone new walk through it.",
    trigger: 'expansion',
    tool: { href: '/assessment', label: 'Start the Free Check-up' },
  },
  {
    id: 'we-need-a-grant-writer',
    title: '"We need a grant writer"',
    signal: 'Proposals go out, but larger funders keep saying no.',
    assumption: 'The organization needs better proposal writing.',
    constraint: "The evidence behind the story is thin. Outcomes are measured for one program, or none, and the numbers don't match from report to report.",
    evidence: 'Outcomes tracked per program, the last two funder reports side by side, and whether a one-page logic model exists for the largest program.',
    action: 'Draft a one-page logic model for your largest program, pick one outcome, and start measuring it with every participant this quarter. Use the same number in every report.',
    trigger: 'funder',
    tool: { href: '/candid-seal', label: 'Check your Candid Seal path' },
  },
];

// Research notes. Add new entries at the top. Each links forward to the
// free tool that scores that area, so readers have a next step.
const insights = [
  {
    id: 'transparency-premium',
    title: 'The Transparency Premium',
    body: [
      "In Candid's study of nearly 149,000 U.S. nonprofits, organizations displaying a Seal of Transparency received, on average, 62% more in contributions the following year than comparable organizations without one, after adjusting for size, financial health, age, and governance. The pattern held for small nonprofits too (61%).",
      'The Seal is free. It depends on how complete your public Candid profile is: mission, programs, financials, and leadership. Candid notes that a Seal is associated with higher giving, not a guarantee of it. Still, keeping your profile current is one of the cheapest trust signals a nonprofit can send. Funders read your public Form 990 the same way, so the governance answers there matter too.',
    ],
    source: 'Candid Research, "Study confirms nonprofit transparency: Candid Seals boost donor contributions"',
    next: { href: '/candid-seal', label: 'Find your path to a Candid Platinum Seal' },
  },
  {
    id: 'first-gift-cliff',
    title: 'The First-Gift Cliff',
    body: [
      "Nationally, roughly 4 in 5 first-time donors never make a second gift: first-time donor retention sits around 18%, well below the 43% overall average.",
      "A structured stewardship process in a donor's first 90 days is one of the highest-leverage, lowest-cost fixes most nonprofits have available.",
    ],
    source: 'Fundraising Effectiveness Project, Association of Fundraising Professionals & GivingTuesday',
    next: { href: '/revenue-growth-score', label: 'Score your donor retention' },
  },
  {
    id: 'recurring-giving',
    title: 'The Recurring-Giving Advantage',
    body: [
      'After one year, 71% of monthly donors are still giving, compared to just 24% of new one-time donors.',
      'Converting even a portion of one-time donors into monthly sustainers does more for long-term revenue stability than acquiring new donors at the same rate.',
    ],
    source: 'M+R Benchmarks, an annual digital fundraising study',
    next: { href: '/revenue-growth-score', label: 'See where your revenue stands' },
  },
  {
    id: 'planned-giving-gap',
    title: 'The Planned-Giving Gap',
    body: [
      "Charitable bequests have made up roughly 7-9% of all U.S. giving in most years over the past four decades, and reached just over 10% in 2025, yet most nonprofits still don't have even a basic planned-giving program.",
      "At one studied institution, realized bequest gifts averaged 21 times a donor's lifetime annual giving, so a planned-giving conversation is also a marker of a donor's deepest capacity, not just a future line item.",
    ],
    source: 'Giving USA; the Chronicle of Philanthropy; PG Calc planned-giving research',
    next: { href: '/institutional-advancement-score', label: 'Score your fundraising program' },
  },
];
---

<BaseLayout
  title="Nonprofit Research & Insights | Frankly Inspired"
  description="Field notes on what growing nonprofits usually mistake for their real problem, the Institutional Durability Index from free-tool data, and short sourced research notes."
  footerVariant="home"
>
  <Header variant="full" />

  <main id="main">
    <section class="section assessment-intro">
      <div class="container narrow center">
        <p class="eyebrow eyebrow-dark">Insights</p>
        <h1>Field notes and research</h1>
        <p class="hero-sub-light">The problem a leader names is often not the one holding the organization back. These notes show the difference: what leaders notice, what it usually turns out to be, and the first move to make.</p>
      </div>
    </section>

    <!-- ============ THE PROBLEM BEHIND THE PROBLEM ============ -->
    <!-- Sector figures as of Nov 2026: NFF 2025 State of the Nonprofit
         Sector Survey; CEP State of Nonprofits 2026. Recheck yearly. -->
    <section id="pattern" class="section problem-section">
      <div class="container">
        <p class="tag-chip tc-blue reveal">The pattern</p>
        <h2 class="section-title reveal">The problem behind the problem</h2>
        <p class="section-note scrub">Nonprofits rarely struggle because the mission lacks value. They become fragile when the institution doesn't mature as fast as the programs, the funding, and the expectations.</p>
        <div class="problem-stats" data-count>
          <div class="stat reveal"><span class="stat-num">36%</span><span class="stat-label">of nonprofits ended 2024 with an operating deficit, the highest in ten years</span></div>
          <div class="stat reveal"><span class="stat-num">52%</span><span class="stat-label">hold three months of cash or less</span></div>
          <div class="stat reveal"><span class="stat-num">57%</span><span class="stat-label">of nonprofit CEOs say foundation grants have become harder to win since January 2025</span></div>
        </div>
        <p class="problem-source reveal">Sources: <a href="https://nff.org/insights/survey-us-nonprofits-at-critical-point-as-funding-for-community-needs-falters/" target="_blank" rel="noopener">Nonprofit Finance Fund, 2025</a>; <a href="https://cep.org/report-backpacks/state-of-nonprofits-2026/" target="_blank" rel="noopener">Center for Effective Philanthropy, 2026</a>.</p>
        <div class="bubble-pair">
          <div class="bubble bubble-said pop">
            <p class="problem-label">What leaders say</p>
            <p class="problem-said">&ldquo;We need a grant writer.&rdquo;</p>
          </div>
          <div class="bubble bubble-found pop">
            <p class="problem-label">What it often turns out to be</p>
            <p class="problem-found">Thin evidence behind the story. Outcomes are measured for one program, or none, so larger funders can't say yes.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section alt-bg" id="field-notes">
      <div class="container narrow">
        <h2 class="section-title reveal">Field notes</h2>
        <p class="section-note reveal">Franklin's observations from leading and advising growing organizations. These are patterns to check, not research findings.</p>
        {fieldNotes.map((n) => (
          <article id={n.id} class="field-note reveal">
            <h2>{n.title}</h2>
            <dl>
              <dt>Signal</dt><dd>{n.signal}</dd>
              <dt>Usual assumption</dt><dd>{n.assumption}</dd>
              <dt>Often it's</dt><dd class="fn-constraint">{n.constraint}</dd>
              <dt>Check</dt><dd>{n.evidence}</dd>
              <dt>First 90 days</dt><dd>{n.action}</dd>
            </dl>
            <a class="link-more" href={n.tool.href}>{n.tool.label} &rarr;</a>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="durability-index">
      <div class="container narrow">
        <DurabilityIndex />
      </div>
    </section>

    <section class="section alt-bg" id="research">
      <div class="container narrow">
        <h2 class="section-title reveal">What the research shows</h2>
        {insights.map((i) => (
          <article id={i.id} class="insight-article reveal">
            <h2>{i.title}</h2>
            {i.body.map((p) => <p>{p}</p>)}
            <p class="insight-source">Source: {i.source}</p>
            <a class="link-more" href={i.next.href}>{i.next.label} &rarr;</a>
          </article>
        ))}
      </div>
    </section>

    <!-- Recent public major gifts, from the operations app's Giving
         Landscape (refreshed weekly by its own automation). Hidden until
         the feed returns at least one gift. -->
    <section id="recent-gifts" class="section" hidden>
      <div class="container">
        <h2 class="section-title">Recent Major Gifts</h2>
        <p class="section-note">Publicly announced gifts of $100,000 or more, tracked weekly. Useful as a read on where large gifts are going right now.</p>
        <div class="card-grid" id="recent-gifts-list"></div>
      </div>
    </section>

    <section class="section closing-cta">
      <div class="container narrow center">
        <h2 class="reveal">Want to know which of these matters most for you?</h2>
        <p class="reveal">A 30-minute conversation is the fastest way to find out.</p>
        <a class="btn btn-primary reveal" href={CALENDLY_URL} target="_blank" rel="noopener" data-track="schedule_click">Schedule a Conversation</a>
      </div>
    </section>
  </main>

  <ScrollReveal />
  <HomeMotion />
</BaseLayout>

<script>
  const API_BASE = 'https://frankly-inspired-api.onrender.com';
  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c] as string));
  const money = (n: number) => n >= 1e9 ? '$' + (n / 1e9).toFixed(1).replace(/\.0$/, '') + 'B'
    : n >= 1e6 ? '$' + (n / 1e6).toFixed(1).replace(/\.0$/, '') + 'M'
    : '$' + Math.round(n / 1e3) + 'K';
  fetch(API_BASE + '/api/giving-landscape?limit=6')
    .then((r) => (r.ok ? r.json() : null))
    .then((data) => {
      const gifts = data && Array.isArray(data.gifts) ? data.gifts : [];
      if (!gifts.length) return;
      const list = document.getElementById('recent-gifts-list');
      const section = document.getElementById('recent-gifts');
      if (!list || !section) return;
      list.innerHTML = gifts.map((g: any) => `
        <div class="card card-static">
          <span class="offering-badge">${esc(money(Number(g.amount) || 0))}</span>
          <h4>${esc(g.org)}</h4>
          <p>${esc(g.headline)}</p>
          <p class="insight-source">${esc([g.donor, g.state, g.announcedAt].filter(Boolean).join(' · '))}</p>
          ${/^https?:\/\//.test(g.url || '') ? `<a class="link-more" href="${esc(g.url)}" target="_blank" rel="noopener">Source: ${esc(g.source || 'link')} &rarr;</a>` : ''}
        </div>`).join('');
      section.hidden = false;
    })
    .catch(() => {});
</script>
