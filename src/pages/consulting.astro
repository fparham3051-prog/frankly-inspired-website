---
import Term from '../components/Term.astro';
import MarkDivider from '../components/MarkDivider.astro';
import { CALENDLY_URL, SCORECARD_URL } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

// The full consulting detail: seven dimensions, method, engagement options
// and pricing, a sample diagnostic, the funder-sponsorship path, and the
// FAQ. Moved off the homepage (Nov 2026) so the homepage reads in two
// minutes; old /consulting#pricing, /consulting, etc. links forward here (see the
// hash-forwarding script in index.astro).
const FUNDER_LETTER = `Dear [Program Officer name],

[Organization] is committed to strengthening the systems behind our work, and we'd like to request [amount: $2,000 or $2,500] in capacity-building support for an independent organizational diagnostic.

The Diagnostic from Frankly Inspired and Associates, LLC, built on its InstitutionalOS system, scores our organization on seven dimensions (strategy, program and impact evidence, revenue and financial health, leadership, operations, partnerships, and governance and risk), verifies the evidence behind each score, and names the single constraint most limiting our progress. It ends with a written memo and a 90-Day Improvement Plan, including the steps to our next Candid Seal of Transparency level, with weekly check-ins, a 90-day review, and a six-month reassessment.

We'd be glad to share the results with you, so the diagnostic informs our partnership as well as our own planning.

Thank you for considering this request.

[Your name]
[Title], [Organization]`;
---

<BaseLayout
  title="Consulting and Pricing | Frankly Inspired"
  description="The Diagnostic on three paths, Build, Fund or Sustain ($2,000 to $2,500), the Advisory and Implementation Retainer, project engagements, and executive coaching for nonprofit leaders, built on the seven-dimension Health Index."
  footerVariant="home"
>
  <Header variant="full" />

  <main id="main">
    <!-- ============ CONSULTING AND ADVISORY ============ -->
    <section id="consulting" class="section consulting">
      <div class="container">
        <h1 class="section-title reveal">Strategy for organizations that want to last.</h1>
        <p class="section-note reveal">Frankly Inspired and Associates, LLC works with mission-driven institutions that need more than a short-term fix. Engagements are designed around the organization's context, capacity, leadership needs, and sustainability goals.</p>

        <div class="fit-box reveal" id="who-we-work-with">
          <h2 class="subhead">Who we work with</h2>
          <div class="fit-grid">
            <div>
              <h3 class="fit-h">The organization</h3>
              <ul class="bullet-list">
                <li>Youth, education, workforce, and human services nonprofits in DC, Maryland, and Virginia</li>
                <li>Annual revenue of roughly $500,000 to $20 million</li>
                <li>Growing, or under pressure to: more programs, more sites, larger funders</li>
                <li>A team big enough that the executive director can no longer hold every decision, but without a full layer of senior managers</li>
              </ul>
            </div>
            <div>
              <h3 class="fit-h">The moment</h3>
              <ul class="bullet-list">
                <li>A second site, city, or program is on the table</li>
                <li>A larger funder or a multi-year grant is coming up</li>
                <li>Everything still runs through the founder or executive director</li>
                <li>Staff grew, but the strain didn't go down</li>
                <li>A leadership transition is likely in the next two years</li>
              </ul>
            </div>
            <div>
              <h3 class="fit-h">Probably not a fit</h3>
              <ul class="bullet-list">
                <li>You need a grant writer, bookkeeper, or attorney (we'll refer you)</li>
                <li>You want a full strategic plan written for you</li>
                <li>There's no decision ahead that the answer would change</li>
              </ul>
            </div>
          </div>
          <p class="fit-note">Our <a href="/dmv-nonprofit-health">DMV Nonprofit Health Brief</a> shows why this group: 38% of growing nonprofits in this range show financial strain while they grow.</p>
        </div>

        <!-- One framework everywhere: the seven InstitutionalOS Health Index
             dimensions. The pillar-* ids on these cards are kept because the
             self-assessment's results link to them per pillar. -->
        <MarkDivider step={2} />
        <h3 id="dimensions" class="subhead reveal">The Seven Dimensions</h3>
        <p class="section-note reveal">Every tool and engagement works on the same seven areas, so a score means the same thing everywhere. Each is work Franklin has done himself, not only advised on.</p>
        <div class="card-grid dims-grid">
          <div class="card card-static reveal" id="pillar-sustainability">
            <span class="offering-badge">1</span>
            <h4>Strategy and Positioning</h4>
            <p>Strategic priorities, risk, and a roadmap that guides real decisions.</p>
            <details class="pillar-proof"><summary>Franklin's experience</summary><p>Set strategy for a two-city region; earlier, prepared Board of Trustees materials and financial analysis for a university CFO's office (Wentworth).</p></details>
          </div>
          <div class="card card-static reveal" id="pillar-program">
            <span class="offering-badge">2</span>
            <h4>Program and Impact Evidence</h4>
            <p>Showing what your programs achieve, in terms funders and boards trust.</p>
            <details class="pillar-proof"><summary>Franklin's experience</summary><p>Led alumni data collection and analysis to improve programs at The Hidden Genius Project; built community-engagement tracking at Wentworth using the Carnegie Classification as a model.</p></details>
          </div>
          <div class="card card-static reveal" id="pillar-revenue">
            <span class="offering-badge">3</span>
            <h4>Revenue and Financial Health</h4>
            <p>Diversified revenue, reserves, donor retention, grants, and fundraising strategy.</p>
            <details class="pillar-proof"><summary>Franklin's experience</summary><p>Set fundraising budgets, goals, and out-year projections at the Society of American Foresters; managed a 700-prospect leadership and planned gift database at Brandeis; built leadership-level prospect pipelines in donor relations at George Washington University.</p></details>
          </div>
          <div class="card card-static reveal" id="pillar-leadership">
            <span class="offering-badge">4</span>
            <h4>Leadership and Organizational Capacity</h4>
            <p>Bench strength, succession, alignment, and executive advising through change.</p>
            <details class="pillar-proof"><summary>Franklin's experience</summary><p>Owned staffing for a two-city region, trained staff and volunteers on program methods, and supervised residence-life teams responsible for 550 residents.</p></details>
          </div>
          <div class="card card-static reveal" id="pillar-operations">
            <span class="offering-badge">5</span>
            <h4>Operations and Infrastructure</h4>
            <p>Workflows, KPIs, CRM and Salesforce practice, and AI readiness.</p>
            <details class="pillar-proof"><summary>Franklin's experience</summary><p>Built KPI frameworks and Salesforce data governance for a national alumni model; works in Salesforce, Salesloft, iMIS, Sage Millennium, Advance, and Tessitura.</p></details>
          </div>
          <div class="card card-static reveal" id="pillar-partnership">
            <span class="offering-badge">6</span>
            <h4>Partnerships and Ecosystem</h4>
            <p>Cross-sector partnerships with education, workforce, government, corporate, and philanthropic partners.</p>
            <details class="pillar-proof"><summary>Franklin's experience</summary><p>Built 20+ cross-sector partnerships in the Mid-Atlantic, onboarded college-access partners such as Beyond 12, and managed sponsors, exhibitors, and affinity partners at the Society of American Foresters.</p></details>
          </div>
          <div class="card card-static reveal" id="pillar-governance">
            <span class="offering-badge">7</span>
            <h4>Governance and Risk</h4>
            <p>Board practice, policies, filings, and the risks a funder will ask about.</p>
            <details class="pillar-proof"><summary>Franklin's experience</summary><p>Served as staff liaison to a national association's Revenue Development committee, staffed a dean's Board of Advisors at George Washington University, and today is a board advisor to the Turner Foundation for Community Advocacy and strategic fundraising advisor to the Ora Lee Smith Cancer Research Foundation.</p></details>
          </div>
        </div>

        <MarkDivider step={3} />
        <h3 id="which-fits" class="subhead reveal">Which option fits your situation</h3>
        <div class="org-table-wrap reveal"><table class="org-table fit-table">
          <thead><tr><th>If this is where you are</th><th>Start here</th><th>What you walk away with</th></tr></thead>
          <tbody>
            <tr><td>You sense something is off but can't name it, or you're not ready to spend yet</td><td><a href="/assessment">Free Check-up</a></td><td>A score on all seven dimensions and your likely constraint, in about 7 minutes</td></tr>
            <tr><td>A decision is coming (expansion, a major grant, a leadership change) and you need to know what will break first</td><td><a href="#pricing">The Diagnostic</a> (Build, Fund or Sustain)</td><td>The one gap that will break first, verified with evidence, and a 90-day plan with owners and dates</td></tr>
            <tr><td>You have the diagnosis and need help closing the gap week to week</td><td><a href="#pricing-advisory">Advisory and Implementation Retainer</a></td><td>The plan carried out, with progress tracked in your portal and a board-ready update each quarter</td></tr>
            <tr><td>The gap is one defined piece of work, such as a revenue diversification plan or partnership strategy</td><td><a href="#pricing-advisory">Project engagement</a></td><td>That one deliverable, scoped and priced before we start</td></tr>
            <tr><td>The pressure is on you as the leader, not only the organization</td><td><a href="#coaching">Executive Coaching</a></td><td>A confidential hour to think through decisions, as often as you need it</td></tr>
          </tbody>
        </table></div>

        <h3 id="pricing" class="subhead reveal">Engagement Options</h3>
        <p class="section-note reveal">Every path follows the same four steps: the free check-up, the Diagnostic, the work itself, and a quarterly re-score to keep the gains.</p>
        <div class="pricing-grid">
          <div class="pricing-card reveal" style="align-self:start;">
            <span class="offering-badge">Step 1 &middot; Free</span>
            <h4>Start with the Free Check-up</h4>
            <p class="price">$0<span>no sign-up</span></p>
            <p class="plan-fit">Seven minutes, no sign-up. Your results suggest your path: Build, Fund or Sustain.</p>
            <a class="btn btn-secondary" href="/assessment" data-track="tool_start" data-tool="consulting">Start the Free Check-up</a>
          </div>
          <div class="pricing-card featured reveal" id="build">
            <span id="fund" class="anchor-offset"></span>
            <span id="sustain" class="anchor-offset"></span>
            <span class="offering-badge">Step 2: The Diagnostic</span>
            <h4>Know what to build next, what it costs, and how to fund it</h4>
            <p class="plan-fit">One Diagnostic, three paths. Pick the one that sounds like you; the path sets the price and what we look at first.</p>
            <div class="stage-toggle" role="tablist" aria-label="Organization stage">
              <button type="button" role="tab" class="stage-tab" data-stage="build" aria-selected="false">Build</button>
              <button type="button" role="tab" class="stage-tab" data-stage="fund" aria-selected="true">Fund</button>
              <button type="button" role="tab" class="stage-tab" data-stage="sustain" aria-selected="false">Sustain</button>
            </div>
            <div class="stage-panel" data-stage-panel="build" hidden>
              <p class="price">$2,000<span>flat fee</span></p>
              <p><strong>Build: Get the foundation right.</strong> For new and founder-led organizations, usually growth stage 1. We look at your board, policies and books first, so the first big funder finds them ready.</p>
            </div>
            <div class="stage-panel" data-stage-panel="fund">
              <p class="price">$2,500<span>flat fee</span></p>
              <p><strong>Fund: Get ready for bigger money.</strong> For growing organizations going after larger grants, usually growth stage 2. We score your finances from your filed IRS Form 990s, not estimates, and check them against the funders you're targeting.</p>
            </div>
            <div class="stage-panel" data-stage-panel="sustain" hidden>
              <p class="price">$2,500<span>flat fee</span></p>
              <p><strong>Sustain: Make it last beyond one person.</strong> For established organizations where too much runs through one leader, usually growth stage 3 and up. We look at leadership, succession and reserves first, so the work outlasts any one person.</p>
            </div>
            <ul class="bullet-list">
              <li>A clear picture: your score and growth stage, with the evidence behind each of the seven areas</li>
              <li>A written memo naming the one gap that will break first</li>
              <li>A priced plan: your next hires, a fundraising goal, and a plan for your board</li>
              <li>A 90-day plan with owners and dates, including the steps to your next Candid Seal level</li>
              <li>A live readout, plus a private workspace to track progress and prove it's working</li>
            </ul>
            <p class="plan-fit" style="font-size:0.85em;">Built on InstitutionalOS, our scoring and planning system.</p>
            <a class="btn btn-primary plan-cta" href="/?plan=The+Diagnostic#contact" data-plan="The Diagnostic">Discuss Your Diagnostic</a>
          </div>
          <div class="pricing-card reveal" id="pricing-advisory">
            <span id="pricing-implementation" class="anchor-offset"></span>
            <span class="recommended-badge" hidden>Recommended for you</span>
            <span class="offering-badge">Step 3: Do the work</span>
            <h4>Advisory and Implementation Retainer</h4>
            <p class="price">$2,500 to $3,500<span>per month</span></p>
            <p class="plan-fit">Ongoing help closing the gap the Diagnostic found, from periodic guidance to weekly hands-on work. Scope is set together at the readout.</p>
            <ul class="bullet-list">
              <li>Strategy sessions, monthly or weekly</li>
              <li>Revenue, operations, and stakeholder guidance, with document review</li>
              <li>Hands-on implementation when weekly is the right fit</li>
              <li>A board-ready progress report each quarter</li>
              <li>Three-month minimum</li>
            </ul>
            <p class="plan-fit"><strong>Prefer a fixed 90 days?</strong> A 90-Day Sprint carries out your plan with a set scope, priced in your proposal. A single defined project is priced to scope.</p>
            <a class="btn btn-primary plan-cta" href="/?plan=Advisory+and+Implementation+Retainer#contact" data-plan="Advisory and Implementation Retainer">Start This Retainer</a>
            <a class="btn btn-ghost plan-cta" href="/?plan=Project+Based+Engagement#contact" data-plan="Project Based Engagement">Discuss a Project</a>
          </div>
        </div>
        <p class="section-note reveal"><strong>Step 4: Keep it.</strong> A quarterly re-score shows your board the trend, not a snapshot, and tells you what to work on next.</p>
        <!-- Coaching is for the leader, not the organization: a different buyer,
             so it sits outside the organizational ladder above. -->
        <div class="leader-callout reveal" id="coaching">
          <div>
            <p class="leader-callout-label">For the leader</p>
            <h4>1:1 Executive Coaching &middot; $350 per session</h4>
            <p>Confidential 60-minute sessions for executive directors and senior leaders: decision making, change leadership, and a space outside board and staff dynamics. Book as needed, no minimum, on its own or alongside any engagement.</p>
          </div>
          <a class="btn btn-secondary plan-cta" href="/?plan=1%3A1+Executive+Coaching#contact" data-plan="1:1 Executive Coaching">Book a Coaching Session</a>
        </div>
        <p class="pricing-reassurance reveal">Not sure which option fits? <a href="/#contact">Start with a conversation</a>, and I'll help you figure out the right scope. To share this with your board: <a href="/assets/docs/institutionalos-diagnostic-overview.pdf" download data-track="overview_download" data-doc="leader">download the two-page Diagnostic overview (PDF)</a>.</p>

        <MarkDivider step={4} />
        <h3 id="what-happens" class="subhead reveal">What happens before, during, and after the Diagnostic</h3>
        <ol class="timeline reveal">
          <li><span class="tl-when">Before</span><div><strong>A free 30-minute conversation.</strong> We talk about the decision in front of you, by when, and who decides. If a Diagnostic isn't the right step, I'll say so. If it is, you get a one-page proposal and engagement letter within a few days.</div></li>
          <li><span class="tl-when">Week 1</span><div><strong>Kickoff.</strong> An intake with the executive director (and board chair, if possible). We request the evidence: 990s, budget, policies, org chart, and how work actually runs. A six-minute leader survey goes to the executive director, board, and senior staff.</div></li>
          <li><span class="tl-when">Weeks 2 to 3</span><div><strong>Scoring on evidence.</strong> Each of the seven areas is scored on what can be shown, with a note explaining every score. Gaps between what leaders say and what the documents show are flagged.</div></li>
          <li><span class="tl-when">Week 4</span><div><strong>Readout.</strong> A 60 to 90 minute session with your leadership: the scorecard, the memo naming the one gap that will break first (and the runner-up), and the 90-Day Improvement Plan. Your private client portal opens the same day.</div></li>
          <li><span class="tl-when">After</span><div><strong>The plan runs.</strong> Your team logs a 15-minute weekly check-in in the portal. The 90-day review and the six-month reassessment are booked before we close, so you can see what actually moved. Continuing support is optional, never assumed.</div></li>
        </ol>

        <MarkDivider step={5} />
        <h3 id="30-60-90" class="subhead reveal">What's done by day 30, 60, and 90</h3>
        <div class="trust-grid reveal">
          <div class="trust-card"><h3 class="h4-style">By day 30</h3><ul><li>Diagnostic complete: scorecard, memo, and readout</li><li>The gap to fix first named and agreed by leadership</li><li>A 90-Day Improvement Plan: one target and three to six actions, each with an owner and a date</li><li>Client portal live, weekly check-ins started</li></ul></div>
          <div class="trust-card"><h3 class="h4-style">By day 60</h3><ul><li>First actions finished, with the evidence logged</li><li>A month-one check: does the diagnosis still hold?</li><li>Anything blocked unblocked or re-planned</li><li>A progress view you can share with your board</li></ul></div>
          <div class="trust-card"><h3 class="h4-style">By day 90</h3><ul><li>The 90-day review: what moved, shown with evidence, not impressions</li><li>The change written down, owned, and taught to staff</li><li>The next constraint in line, and a decision: next plan, retainer, or close out</li><li>Six-month reassessment on the calendar</li></ul></div>
        </div>

        <MarkDivider step={6} />
        <h3 id="price-logic" class="subhead reveal">What the price is weighed against</h3>
        <p class="section-note reveal">The Diagnostic is priced against the decision it informs, not the hours it takes. A flat $2,000 to $2,500 is small next to what it protects:</p>
        <ul class="bullet-list reveal">
          <li><strong>Expansion:</strong> opening a second site before the first one runs without you can cost a year of operating budget and staff you can't keep.</li>
          <li><strong>A major grant:</strong> a declined multi-year application, or one awarded and then poorly reported, shapes how that funder sees you for years.</li>
          <li><strong>Hiring:</strong> adding staff to fix what is really a decision-rights or workflow problem adds payroll without adding capacity.</li>
          <li><strong>Leadership transition:</strong> relationships and knowledge that live in one person leave with that person.</li>
        </ul>
        <p class="section-note reveal">That's also why the fee is fixed and the scope is defined: it's an easy, bounded request for your board or a funder to approve.</p>

        <MarkDivider step={7} />
        <h3 id="sample-diagnostic" class="subhead reveal">What You Actually Receive</h3>
        <p class="section-note reveal"><em>Illustrative example, not a real client. This shows the format of a completed diagnostic, not a claimed result.</em></p>
        <p><strong>Organization:</strong> Sample Community Youth Alliance (fictional, for illustration only)<br />
        <strong>Path:</strong> Sustain (make it last beyond one person)<br />
        <strong>Candid Seal today:</strong> Silver</p>
        <div class="org-table-wrap" tabindex="0" role="region" aria-label="Sample scorecard"><table class="org-table fit-table sample-table">
          <thead><tr><th>Area</th><th>Score</th><th>What the evidence showed</th></tr></thead>
          <tbody>
            <tr><td><strong>Strategy and Positioning</strong></td><td>68</td><td>Written strategic plan in use; no written criteria for saying no to new opportunities.</td></tr>
            <tr><td><strong>Program and Impact Evidence</strong></td><td>52</td><td>Outputs tracked for every program; outcomes measured for only one.</td></tr>
            <tr><td><strong>Revenue and Financial Health</strong></td><td>58</td><td>Two years of filed financials reviewed; no reserve policy on file.</td></tr>
            <tr><td><strong>Leadership and Organizational Capacity</strong></td><td>44</td><td>Single point of failure identified in program leadership.</td></tr>
            <tr><td><strong>Operations and Infrastructure</strong></td><td>66</td><td>Core workflows documented; no KPI dashboard in use.</td></tr>
            <tr><td><strong>Partnerships and Ecosystem</strong></td><td>63</td><td>Strong partners, but only two of eight formalized.</td></tr>
            <tr><td><strong>Governance and Risk</strong></td><td>71</td><td>Bylaws and Form 990 policies current; succession plan not documented.</td></tr>
          </tbody>
        </table></div>
        <p><strong>Constraint identified:</strong> Leadership bench strength is the <Term def="The one gap most likely to stall your next funding, growth, or leadership decision. It's chosen on evidence, not simply your lowest score.">binding constraint</Term>, not financial health, which is often assumed to be the problem.</p>
        <p><strong>90-day target:</strong> 44 to 58 (closing 25% of the gap to 100), via a documented succession plan for the top two program roles and one cross-trained backup per critical function.</p>
        <p><strong>Candid Seal step:</strong> Silver to Gold by uploading the latest filed Form 990 and completing the leader demographic fields, both already in hand.</p>
        <p><strong>What you get:</strong> the full scorecard above, a written memo explaining each score, and a 60-90 minute session walking through the plan, delivered whether the news is good or hard to hear.</p>
        <p><a class="link-more" href="/assets/docs/sample-board-report.pdf" target="_blank" rel="noopener" data-track="sample_board_report">Download a sample board report (PDF, fictional organization) &rarr;</a></p>

        <p class="pricing-reassurance reveal">Not ready for a conversation yet? <a href="/tools">Take a free assessment</a> first, it points to where to focus.</p>
      </div>
    </section>


    <!-- ============ GET IT FUNDED ============ -->
    <section id="funder-sponsored" class="section alt-bg">
      <div class="container narrow">
        <h2 class="section-title reveal">Ask a funder to sponsor your Diagnostic</h2>
        <p class="reveal">Many funders set aside capacity-building money, and groups such as Exponent Philanthropy encourage them to pay for organizational assessments. A Diagnostic is an easy request: a fixed price, a clear deliverable, and results you can share.</p>
        <ol class="bullet-list reveal">
          <li>Copy the letter and fill in the brackets.</li>
          <li>Send it to a program officer who knows your work.</li>
          <li><a href="/#contact">Tell me</a> you've asked. I can join a call with the funder if that helps.</li>
        </ol>
        <div class="funder-letter reveal">
          <details class="letter-fold"><summary>Read the letter</summary><pre id="funder-letter-text" tabindex="0" aria-label="Funder sponsorship letter text">{FUNDER_LETTER}</pre></details>
          <div class="hero-ctas">
            <button type="button" class="btn btn-secondary" id="copy-funder-letter" data-track="funder_letter_copy">Copy the Letter</button>
            <a class="btn btn-ghost" id="email-funder-letter" href={`mailto:?subject=${encodeURIComponent('Capacity-building request: organizational diagnostic')}&body=${encodeURIComponent(FUNDER_LETTER)}`} data-track="funder_letter_email">Open in Email</a>
            <span class="form-status" id="copy-status" role="status" aria-live="polite"></span>
          </div>
        </div>

        <div class="cohort-offer reveal" id="funder-cohort">
          <p class="offering-badge">For funders</p>
          <h3>Sponsor a Diagnostic cohort for your grantees</h3>
          <p>Five to ten grantees each get a confidential Diagnostic, a written memo, a 90-Day Improvement Plan, and a six-month reassessment. Your foundation gets an anonymized portfolio report showing the most common constraints across the cohort, plus a shared learning session. No grantee's individual results are shared without its permission.</p>
          <p class="price">From $15,000 <span>for a cohort of five, including the portfolio report</span></p>
          <div class="hero-ctas">
            <a class="btn btn-primary plan-cta" href="/?plan=The+Diagnostic#contact" data-plan="The Diagnostic" data-track="cohort_inquiry">Discuss a Cohort</a>
            <a class="btn btn-secondary" href="/assets/docs/funder-cohort-overview.pdf" download data-track="overview_download" data-doc="funder">Download the Funder Overview (PDF)</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section id="your-information" class="section">
      <div class="container">
        <h2 class="section-title reveal">How your information is handled</h2>
        <div class="trust-grid reveal">
          <div class="trust-card"><h3 class="h4-style">Used for your Diagnostic only</h3><p>What you share is used to score, write the memo, and hold the readout. It's never sold, and never reused for another engagement without your knowledge.</p></div>
          <div class="trust-card"><h3 class="h4-style">Private by default</h3><p>Your workspace opens by a link only your team holds. A funder sees results only if you choose to share a separate, funder-safe view, without your internal notes.</p></div>
          <div class="trust-card"><h3 class="h4-style">Yours to remove</h3><p>Free check-up answers stay in your browser. After an engagement, ask and the source documents you shared are deleted. AI that helps prepare drafts is checked by a person before anything reaches you. <a href="/privacy">Privacy policy</a></p></div>
        </div>
      </div>
    </section>

    <section id="faq" class="section faq">
      <div class="container narrow">
        <h2 class="section-title reveal">Frequently Asked Questions</h2>
        <div class="faq-list reveal">
          <details>
            <summary>What documents will I need to share?</summary>
            <p>For the Fund Diagnostic, financial health is scored from your public IRS Form 990 filings, so you don't need to send them. For any diagnostic, you can choose to share governance policies, board materials, financial statements, or strategic plans to support the evidence review.</p>
          </details>
          <details>
            <summary>How is my organization's information handled?</summary>
            <p>What you share is used only to complete your diagnostic. It's never sold or reused for another engagement without your knowledge, and you can ask for shared source materials to be deleted once the engagement ends. See the <a href="/privacy">Privacy Policy</a>.</p>
          </details>
          <details>
            <summary>Is this legal or accounting advice?</summary>
            <p>No. Where a finding touches legal, accounting, or safeguarding matters, you'll get a referral instead of a substitute opinion: a nonprofit CPA for financial controls and audits, an attorney for legal structure and compliance, a program evaluator for formal impact studies. We'll also tell you when not to proceed yet, for example with an expansion or a major application.</p>
          </details>
          <details>
            <summary>We're not ready to pay for a diagnostic. Where should we start?</summary>
            <p>Take one of the <a href="/tools">free tools</a>. The 7-minute self-assessment covers all seven dimensions and points you to your likely constraint. Every tool you take after that adds to <a href="/health-index">your Health Index</a>, one profile you can print for your board.</p>
          </details>
          <details>
            <summary>How do I make the case to my board?</summary>
            <p>Print your free <a href="/health-index">Health Index</a> and bring it to your next board meeting. It shows all seven dimensions on one page, along with your likely constraint. Your board chair is welcome at the diagnostic's readout session. Some funders also offer capacity-building grants that can cover outside consulting, so ask your program officers.</p>
          </details>
          <details>
            <summary>How are the free tools scored?</summary>
            <p>Every tool uses the same seven dimensions and the same evidence rubric, from "not in place" to "verified." Each question and its research source is published on <a href="/methodology">How Scoring Works</a>.</p>
          </details>
          <details>
            <summary>Can a funder pay for the Diagnostic?</summary>
            <p>Yes. Many funders support capacity building, and the fixed price makes it an easy request. <a href="#funder-sponsored">Use the sponsorship letter</a>, and the invoice can go directly to the funder.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="section closing-cta">
      <div class="container narrow center">
        <h2 class="reveal">Not sure which option fits?</h2>
        <p class="reveal">A 30-minute conversation is the fastest way to find the right scope. Or start free: score your organization first and bring your Health Index to the call.</p>
        <div class="hero-ctas center reveal">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener" data-track="schedule_click">Schedule a Conversation</a>
          <a class="btn btn-secondary" href="/assessment" data-track="tool_start">Start the Free Check-up</a>
        </div>
      </div>
    </section>
  </main>

  <ScrollReveal />
</BaseLayout>

<script>
  import { getStage } from '../scripts/pathway';

  // Diagnostic stage toggle (Build / Fund / Sustain). Starts on the stage
  // the visitor chose in any free tool, or Fund; the choice is remembered.
  (function stageToggle() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.stage-tab'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-stage-panel]'));
    if (!tabs.length) return;
    const fromHash = ['build', 'fund', 'sustain'].find((k) => location.hash === '#' + k);
    const show = (k: string) => {
      tabs.forEach((t) => { const on = t.dataset.stage === k; t.setAttribute('aria-selected', String(on)); t.classList.toggle('is-active', on); });
      panels.forEach((p) => { p.hidden = p.dataset.stagePanel !== k; });
    };
    show(fromHash || getStage() || 'fund');
    tabs.forEach((t) => t.addEventListener('click', () => {
      const k = t.dataset.stage!;
      show(k);
      try { localStorage.setItem('fi_stage', k); } catch { /* still works */ }
      (window as any).fiTrack?.('stage_selected', { stage: k, tool: 'consulting' });
    }));
  })();

  // Highlight the recommended tier when arriving from a tool's results.
  (function highlightRecommendedTier() {
    const hash = window.location.hash.replace('#', '');
    if (hash !== 'pricing-advisory' && hash !== 'pricing-implementation') return;
    const targetCard = document.getElementById(hash);
    if (!targetCard) return;
    targetCard.classList.add('is-recommended');
    const badge = targetCard.querySelector<HTMLElement>('.recommended-badge');
    if (badge) badge.hidden = false;
  })();

  // Funder letter: copy to clipboard.
  document.getElementById('copy-funder-letter')?.addEventListener('click', async () => {
    const text = document.getElementById('funder-letter-text')?.textContent || '';
    const status = document.getElementById('copy-status');
    try {
      await navigator.clipboard.writeText(text);
      if (status) status.textContent = 'Copied.';
    } catch {
      if (status) status.textContent = 'Select the letter above and copy it.';
    }
  });
</script>
