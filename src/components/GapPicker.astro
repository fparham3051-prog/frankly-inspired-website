---
// "Which gap breaks first?" Three quick questions; each answer points to one
// of the seven areas. The most-pointed-to area lights up in red on the dial,
// with a one-line read and a link to the free check-up to confirm it.
// Runs entirely in the browser; nothing is sent or stored.
import SevenMark from './SevenMark.astro';
const AREAS = ['Direction', 'Proof of results', 'Revenue', 'Leadership', 'Operations', 'Partnerships', 'Governance'];
const QUESTIONS: { q: string; options: [string, number][] }[] = [
  { q: 'What worries you most this year?', options: [['Making the budget work next quarter', 2], ['Everything still runs through me', 3], ["We can't show funders what changed", 1], ['Whether the board is really steering', 6]] },
  { q: 'When you try something new, what slows it down?', options: [['No one agrees on what matters most', 0], ['Our processes and data are a mess', 4], ["We don't have the right partners at the table", 5], ['We can’t pay for it', 2]] },
  { q: 'If a major funder called tomorrow, what would you worry about?', options: [['Our outcome data', 1], ['Our financials and Form 990', 6], ['Who would lead the work', 3], ['How it fits our plan', 0]] },
];
const READS = [
  'Direction: without clear priorities and a written way to say no, every new opportunity competes with the work that matters.',
  "Proof of results: funders and boards decide on evidence. If outcomes aren't measured the same way every time, the story won't hold.",
  'Revenue: thin reserves or one dominant funder mean a single decision elsewhere can stall everything here.',
  'Leadership: when decisions route to one person, growth adds questions instead of capacity.',
  "Operations: when workflows live in people's heads, every new hire or site multiplies the strain.",
  "Partnerships: informal partnerships work until someone leaves. What isn't written down doesn't transfer.",
  'Governance: policies, filings, and an engaged board are the first things a serious funder checks.',
];
---
<div class="gap-picker" data-gap-picker data-reads={JSON.stringify(READS)} data-areas={JSON.stringify(AREAS)}>
  <div class="gp-questions">
    {QUESTIONS.map((g, qi) => (
      <fieldset class="gp-q">
        <legend><span class="gp-num">{qi + 1}</span> {g.q}</legend>
        <div class="gp-opts">
          {g.options.map(([label, area]) => (
            <label class="gp-opt"><input type="radio" name={`gp${qi}`} value={String(area)} /> <span>{label}</span></label>
          ))}
        </div>
      </fieldset>
    ))}
  </div>
  <div class="gp-result" aria-live="polite">
    <div class="gp-dial"><SevenMark size={150} filled={0} /></div>
    <p class="gp-read" data-gp-read>Answer the three questions and the dial will show which area is most likely to break first.</p>
    <a class="btn btn-primary gp-cta" href="/assessment" data-track="tool_start" data-tool="gap-picker" hidden data-gp-cta>Confirm it in the free check-up</a>
    <p class="gp-note">A first guess from three answers. The 7-minute check-up scores all seven areas.</p>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-gap-picker]').forEach((root) => {
    const reads: string[] = JSON.parse(root.dataset.reads || '[]');
    const paths = Array.from(root.querySelectorAll<SVGPathElement>('.gp-dial path'));
    const readEl = root.querySelector<HTMLElement>('[data-gp-read]')!;
    const cta = root.querySelector<HTMLElement>('[data-gp-cta]')!;
    root.addEventListener('change', () => {
      const picks = Array.from(root.querySelectorAll<HTMLInputElement>('input[type="radio"]:checked')).map((i) => Number(i.value));
      const tally = new Array(7).fill(0);
      picks.forEach((a) => tally[a]++);
      // Every answered area lights gold; the leader (ties go to the first one picked) turns red.
      let top = -1;
      picks.forEach((a) => { if (top === -1 || tally[a] > tally[top]) top = a; });
      paths.forEach((p, i) => { p.setAttribute('class', i === top && picks.length === 3 ? 'sm-weak' : tally[i] ? 'sm-on' : 'sm-off'); });
      if (picks.length < 3) {
        readEl.textContent = `${3 - picks.length} more to go.`;
        cta.hidden = true;
        return;
      }
      const [name, ...rest] = reads[top].split(': ');
      const why = rest.join(': ');
      readEl.innerHTML = '<span class="gp-label">Most likely to break first</span><strong class="gp-area">' + name + '</strong>' + why.charAt(0).toUpperCase() + why.slice(1);
      cta.hidden = false;
      try { (window as any).fiTrack && (window as any).fiTrack('gap_picker_done', { area: top }); } catch { /* optional */ }
    });
  });
</script>
<style>
  .gap-picker { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 2rem; align-items: start; margin-top: 1.5rem; }
  .gp-q { border: 0; margin: 0 0 1.1rem; padding: 0; }
  .gp-q legend { font-weight: 600; color: var(--navy); margin-bottom: 0.55rem; font-size: 1.02rem; display: flex; align-items: center; gap: 0.5rem; }
  .gp-num { display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--navy); color: #fff; font-size: 0.8rem; }
  .gp-opts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .gp-opt { display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: #fff; cursor: pointer; font-size: 0.93rem; line-height: 1.35; min-height: 44px; }
  .gp-opt:hover { border-color: var(--gold); }
  .gp-opt:has(input:checked) { border-color: var(--gold); background: #FBF6EC; box-shadow: inset 0 0 0 1px var(--gold); }
  .gp-opt input { accent-color: var(--navy); }
  .gp-result { position: sticky; top: 6rem; text-align: center; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem 1.25rem; }
  .gp-dial { display: grid; place-items: center; margin-bottom: 0.9rem; }
  .gp-dial path { transition: stroke 0.35s ease; }
  .gp-read { margin: 0 0 1rem; color: #3a434c; line-height: 1.55; }
  .gp-label { display: block; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: #7A5F27; font-weight: 600; }
  .gp-area { display: block; font-family: var(--font-heading); font-size: 1.5rem; color: #B3402C; margin: 0.15rem 0 0.4rem; }
  .gp-note { margin: 0.8rem 0 0; font-size: 0.82rem; color: #5b6570; }
  @media (max-width: 820px) { .gap-picker { grid-template-columns: 1fr; } .gp-result { position: static; } }
  @media (max-width: 520px) { .gp-opts { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .gp-dial path { transition: none; } }
</style>
