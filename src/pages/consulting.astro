---
import { CALENDLY_URL, SCORECARD_URL } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

// The full consulting detail: seven dimensions, method, engagement options
// and pricing, a sample diagnostic, the funder-sponsorship path, and the
// FAQ. Moved off the homepage (Nov 2026) so the homepage reads in two
// minutes; old /consulting#pricing, /consulting, etc. links forward here (see the
// hash-forwarding script in index.astro).
const FUNDER_LETTER = `Dear [Program Officer name],

[Organization] is committed to strengthening the systems behind our work, and we'd like to request [amount: $2,000 or $2,500] in capacity-building support for an independent organizational diagnostic.

The InstitutionalOS Diagnostic, delivered by Frankly Inspired and Associates, LLC, scores our organization on seven dimensions (strategy, program and impact evidence, revenue and financial health, leadership, operations, partnerships, and governance and risk), verifies the evidence behind each score, and names the single constraint most limiting our progress. It ends with a written memo and a 90-day plan, including the steps to our next Candid Seal of Transparency level, and our progress is re-scored over time.

We'd be glad to share the results with you, so the diagnostic informs our partnership as well as our own planning.

Thank you for considering this request.

[Your name]
[Title], [Organization]`;
---

<BaseLayout
  title="Consulting and Pricing | Frankly Inspired"
  description="The InstitutionalOS Diagnostic ($2,000 to $2,500 by stage), Advisory and Implementation Retainer, project engagements, and executive coaching for nonprofit leaders, built on the seven-dimension Health Index."
  footerVariant="home"
>
  <Header variant="full" />

  <main id="main">
    <!-- ============ CONSULTING AND ADVISORY ============ -->
    <section id="consulting" class="section consulting">
      <div class="container">
        <h1 class="section-title reveal">Strategy for organizations that want to last.</h1>
        <p class="section-note reveal">Frankly Inspired and Associates, LLC works with mission-driven institutions that need more than a short-term fix. Engagements are designed around the organization's context, capacity, leadership needs, and sustainability goals.</p>

        <!-- One framework everywhere: the seven InstitutionalOS Health Index
             dimensions. The pillar-* ids on these cards are kept because the
             self-assessment's results link to them per pillar. -->
        <h3 id="dimensions" class="subhead reveal">The Seven Dimensions</h3>
        <p class="section-note reveal">Every free tool, every diagnostic, and every engagement works on the same seven dimensions, so a score means the same thing everywhere. Each one is work Franklin has done himself, not only advised on.</p>
        <div class="card-grid">
          <div class="card card-static reveal" id="pillar-sustainability">
            <span class="offering-badge">1</span>
            <h4>Strategy and Positioning</h4>
            <p>Strategic priorities, risk, and a roadmap that guides real decisions.</p>
            <p class="pillar-proof"><span>Franklin's experience:</span> Set strategy for a two-city region; earlier, prepared Board of Trustees materials and financial analysis for a university CFO's office (Wentworth).</p>
          </div>
          <div class="card card-static reveal" id="pillar-program">
            <span class="offering-badge">2</span>
            <h4>Program and Impact Evidence</h4>
            <p>Showing what your programs achieve, in terms funders and boards trust.</p>
            <p class="pillar-proof"><span>Franklin's experience:</span> Led alumni data collection and analysis to improve programs at The Hidden Genius Project; built community-engagement tracking at Wentworth using the Carnegie Classification as a model.</p>
          </div>
          <div class="card card-static reveal" id="pillar-revenue">
            <span class="offering-badge">3</span>
            <h4>Revenue and Financial Health</h4>
            <p>Diversified revenue, reserves, donor retention, grants, and fundraising strategy.</p>
            <p class="pillar-proof"><span>Franklin's experience:</span> Set fundraising budgets, goals, and out-year projections at the Society of American Foresters; managed a 700-prospect leadership and planned gift database at Brandeis; built leadership-level prospect pipelines in donor relations at George Washington University.</p>
          </div>
          <div class="card card-static reveal" id="pillar-leadership">
            <span class="offering-badge">4</span>
            <h4>Leadership and Organizational Capacity</h4>
            <p>Bench strength, succession, alignment, and executive advising through change.</p>
            <p class="pillar-proof"><span>Franklin's experience:</span> Owned staffing for a two-city region, trained staff and volunteers on program methods, and supervised residence-life teams responsible for 550 residents.</p>
          </div>
          <div class="card card-static reveal" id="pillar-operations">
            <span class="offering-badge">5</span>
            <h4>Operations and Infrastructure</h4>
            <p>Workflows, KPIs, CRM and Salesforce practice, and AI readiness.</p>
            <p class="pillar-proof"><span>Franklin's experience:</span> Built KPI frameworks and Salesforce data governance for a national alumni model; works in Salesforce, Salesloft, iMIS, Sage Millennium, Advance, and Tessitura.</p>
          </div>
          <div class="card card-static reveal" id="pillar-partnership">
            <span class="offering-badge">6</span>
            <h4>Partnerships and Ecosystem</h4>
            <p>Cross-sector partnerships with education, workforce, government, corporate, and philanthropic partners.</p>
            <p class="pillar-proof"><span>Franklin's experience:</span> Built 20+ cross-sector partnerships in the Mid-Atlantic, onboarded college-access partners such as Beyond 12, and managed sponsors, exhibitors, and affinity partners at the Society of American Foresters.</p>
          </div>
          <div class="card card-static reveal" id="pillar-governance">
            <span class="offering-badge">7</span>
            <h4>Governance and Risk</h4>
            <p>Board practice, policies, filings, and the risks a funder will ask about.</p>
            <p class="pillar-proof"><span>Franklin's experience:</span> Served as staff liaison to a national association's Revenue Development committee, staffed a dean's Board of Advisors at George Washington University, and today is a board advisor to the Turner Foundation for Community Advocacy and strategic fundraising advisor to the Ora Lee Smith Cancer Research Foundation.</p>
          </div>
        </div>

        <h3 class="subhead reveal">How We Work Together</h3>
        <p class="section-note reveal">Every engagement starts the same way: a discovery conversation, followed by the InstitutionalOS Diagnostic scored for your organization's actual lifecycle stage. From there, the method never changes, whether the priority is formation, funding, or long term durability.</p>
        <ol class="process-list reveal">
          <li><strong>Assess.</strong> Structured scoring across the dimensions that matter at your stage, never a generic checklist.</li>
          <li><strong>Verify.</strong> Higher scores require evidence: a documented policy, an observed practice, a filed financial statement, not self reported optimism. A strong score means something because it had to be earned.</li>
          <li><strong>Decide.</strong> We name the binding constraint: the highest-leverage gap right now, the one that will stall your next funding, growth, or leadership decision if it is left alone. Naming it specifically is the job, not producing a wall of generic recommendations.</li>
          <li><strong>Act.</strong> A 90-Day Improvement Plan for the binding constraint: one clear target, and three to six actions, each with an owner, a date, and the evidence that will show it's done. Concrete enough to act on Monday morning.</li>
          <li><strong>Review.</strong> A 15-minute weekly check-in your team logs in its private client portal (what got done, what's blocked, what decision is needed), a monthly look at whether the diagnosis still holds, and a 90-day review.</li>
          <li><strong>Make it standard.</strong> Before we close, we confirm the change is written down, owned, used consistently, taught to new staff, and measured, so it outlasts the engagement.</li>
          <li><strong>Reassess.</strong> A full, evidence-based reassessment at six months shows what actually moved and which constraint is next.</li>
        </ol>
        <p class="section-note reveal">This is the same method behind every free scorecard on this site. A paid diagnostic goes further: it verifies the evidence directly with you and ends in a working session, not just a number.</p>

        <div class="trust-grid reveal" id="how-we-decide">
          <div class="trust-card">
            <h4>How we choose the constraint</h4>
            <p>When two gaps compete, we apply the same rule every time, in this order:</p>
            <ol>
              <li>A failed stage gate outranks a low average.</li>
              <li>The gap others depend on comes first. Weak evidence usually comes before weak fundraising.</li>
              <li>The gap tied to the decision in front of you comes first.</li>
            </ol>
            <p>The runner-up is named in your memo as "next in line," so nothing is hidden.</p>
          </div>
          <div class="trust-card">
            <h4>When we bring in a specialist</h4>
            <p>We diagnose and help fix strategy, partnerships, revenue strategy, leadership capacity, and operations. Where the risk is technical, we flag it and refer you:</p>
            <ul>
              <li>Financial controls and audits: a nonprofit CPA</li>
              <li>Legal structure, employment, and compliance: an attorney</li>
              <li>Formal impact studies: a program evaluator</li>
            </ul>
            <p>We will also tell you when not to proceed yet, for example with an expansion or a major application.</p>
          </div>
          <div class="trust-card">
            <h4>What we don't do</h4>
            <ul>
              <li>Grant writing or proposal production</li>
              <li>Bookkeeping, accounting, or audits</li>
              <li>Legal formation and compliance filings</li>
              <li>Open-ended staffing with no defined outcome</li>
            </ul>
            <p>Saying so up front keeps every engagement focused on the one problem we are best at: finding what is holding the institution back.</p>
          </div>
        </div>

        <h3 id="pricing" class="subhead reveal">Engagement Options</h3>
        <p class="section-note reveal">Every paid engagement begins with the InstitutionalOS Diagnostic. It is the single entry point regardless of your organization's stage, and it is the foundation the work below builds on.</p>
        <div class="pricing-grid">
          <div class="pricing-card reveal" style="align-self:start;">
            <span class="offering-badge">Free</span>
            <h4>Start with the Scorecard</h4>
            <p class="price">$0<span>no sign-up</span></p>
            <p class="plan-fit">Not ready for a diagnostic? Get a free read on all seven dimensions first, then decide.</p>
            <a class="btn btn-secondary" href={SCORECARD_URL} target="_blank" rel="noopener" data-track="tool_start" data-tool="institutionalos-scorecard">Get Your Free Score</a>
          </div>
          <div class="pricing-card featured reveal" id="build">
            <span id="fund" class="anchor-offset"></span>
            <span id="sustain" class="anchor-offset"></span>
            <span class="offering-badge">Step 1: The Entry Point</span>
            <h4>InstitutionalOS Diagnostic</h4>
            <p class="plan-fit">One diagnostic, three stages. Choose yours; the stage sets the price and the emphasis, not the product.</p>
            <div class="stage-toggle" role="tablist" aria-label="Organization stage">
              <button type="button" role="tab" class="stage-tab" data-stage="build" aria-selected="false">Build</button>
              <button type="button" role="tab" class="stage-tab" data-stage="fund" aria-selected="true">Fund</button>
              <button type="button" role="tab" class="stage-tab" data-stage="sustain" aria-selected="false">Sustain</button>
            </div>
            <div class="stage-panel" data-stage-panel="build" hidden>
              <p class="price">$2,000<span>flat fee</span></p>
              <p><strong>Formation Readiness.</strong> For organizations forming or recently launched. Governance and Strategy are scored first, so the foundation holds as you grow.</p>
            </div>
            <div class="stage-panel" data-stage-panel="fund">
              <p class="price">$2,500<span>flat fee</span></p>
              <p><strong>Grant Readiness.</strong> For organizations pursuing grants. Financial Health is scored from your actual filed IRS Form 990 data, not self-reported estimates, and ranked against your target funders.</p>
            </div>
            <div class="stage-panel" data-stage-panel="sustain" hidden>
              <p class="price">$2,500<span>flat fee</span></p>
              <p><strong>Institutional Durability.</strong> For established organizations. A scored, trackable read on financial resilience, leadership succession, and operational maturity.</p>
            </div>
            <ul class="bullet-list">
              <li>All seven Health Index dimensions scored against your stage's benchmarks</li>
              <li>A written memo naming your single binding constraint</li>
              <li>A 90 day plan built on the InstitutionalOS lift formula, including the steps to your next Candid Seal of Transparency level</li>
              <li>A live readout session, plus ongoing access to track your score</li>
            </ul>
            <a class="btn btn-primary plan-cta" href="/?plan=InstitutionalOS+Diagnostic#contact" data-plan="InstitutionalOS Diagnostic">Discuss Your Diagnostic</a>
          </div>
          <div class="pricing-card reveal" id="pricing-advisory">
            <span id="pricing-implementation" class="anchor-offset"></span>
            <span class="recommended-badge" hidden>Recommended for you</span>
            <span class="offering-badge">Step 2</span>
            <h4>Advisory and Implementation Retainer</h4>
            <p class="price">$2,500 to $3,500<span>per month</span></p>
            <p class="plan-fit">Best fit once the diagnostic has named your binding constraint and you want ongoing support closing it. Cadence and scope are set together at the readout, from periodic strategic guidance through weekly hands on implementation.</p>
            <ul class="bullet-list">
              <li>Executive strategy sessions, periodic or weekly depending on scope</li>
              <li>Sustainability, revenue, and operations guidance</li>
              <li>Stakeholder strategy and document review</li>
              <li>Roadmap and revenue pipeline implementation when weekly cadence is the right fit</li>
              <li>Leadership alignment and expanded project support at the implementation level</li>
              <li>Three month recommended minimum</li>
            </ul>
            <p class="plan-fit"><strong>Prefer a fixed scope?</strong> The same work can be done as a defined project, such as a revenue diversification plan or partnership strategy, priced to scope.</p>
            <a class="btn btn-primary plan-cta" href="/?plan=Advisory+and+Implementation+Retainer#contact" data-plan="Advisory and Implementation Retainer">Start This Retainer</a>
            <a class="btn btn-ghost plan-cta" href="/?plan=Project+Based+Engagement#contact" data-plan="Project Based Engagement">Discuss a Project</a>
          </div>
        </div>
        <!-- Coaching is for the leader, not the organization: a different buyer,
             so it sits outside the organizational ladder above. -->
        <div class="leader-callout reveal" id="coaching">
          <div>
            <p class="leader-callout-label">For the leader</p>
            <h4>1:1 Executive Coaching &middot; $350 per session</h4>
            <p>Confidential 60-minute sessions for executive directors and senior leaders: decision making, change leadership, and a space outside board and staff dynamics. Book as needed, no minimum, on its own or alongside any engagement.</p>
          </div>
          <a class="btn btn-secondary plan-cta" href="/?plan=1%3A1+Executive+Coaching#contact" data-plan="1:1 Executive Coaching">Book a Coaching Session</a>
        </div>
        <p class="pricing-reassurance reveal">Not sure which option fits? <a href="/#contact">Start with a conversation</a>, and I'll help you figure out the right scope. To share this with your board: <a href="/assets/docs/institutionalos-diagnostic-overview.pdf" download data-track="overview_download" data-doc="leader">download the two-page Diagnostic overview (PDF)</a>.</p>

        <h3 id="sample-diagnostic" class="subhead reveal">What You Actually Receive</h3>
        <p class="section-note reveal"><em>Illustrative example, not a real client. This shows the format of a completed diagnostic, not a claimed result.</em></p>
        <p><strong>Organization:</strong> Sample Community Youth Alliance (fictional, for illustration only)<br />
        <strong>Pathway:</strong> Sustain (Institutional Durability) Diagnostic<br />
        <strong>Candid Seal today:</strong> Silver</p>
        <ul class="bullet-list">
          <li><strong>1. Strategy and Positioning (68/100).</strong> Written strategic plan in use; no written criteria for saying no to new opportunities.</li>
          <li><strong>2. Program and Impact Evidence (52/100).</strong> Outputs tracked for every program; outcomes measured for only one.</li>
          <li><strong>3. Revenue and Financial Health (58/100).</strong> Two years of filed financials reviewed; no reserve policy on file.</li>
          <li><strong>4. Leadership and Organizational Capacity (44/100).</strong> Single point of failure identified in program leadership.</li>
          <li><strong>5. Operations and Infrastructure (66/100).</strong> Core workflows documented; no KPI dashboard in use.</li>
          <li><strong>6. Partnerships and Ecosystem (63/100).</strong> Strong partners, but only two of eight formalized.</li>
          <li><strong>7. Governance and Risk (71/100).</strong> Bylaws and Form 990 policies current; succession plan not documented.</li>
        </ul>
        <p><strong>Constraint identified:</strong> Leadership bench strength is the binding constraint, not financial health, which is often assumed to be the problem.</p>
        <p><strong>90-day target:</strong> 44 to 58 (closing 25% of the gap to 100), via a documented succession plan for the top two program roles and one cross-trained backup per critical function.</p>
        <p><strong>Candid Seal step:</strong> Silver to Gold by uploading the latest filed Form 990 and completing the leader demographic fields, both already in hand.</p>
        <p><strong>What you get:</strong> the full scorecard above, a written memo explaining each score, and a 60-90 minute session walking through the plan, delivered whether the news is good or hard to hear.</p>

        <p class="pricing-reassurance reveal">Not ready for a conversation yet? <a href="/tools">Take a free assessment</a> first, it points to where to focus.</p>
      </div>
    </section>


    <!-- ============ GET IT FUNDED ============ -->
    <section id="funder-sponsored" class="section alt-bg">
      <div class="container narrow">
        <h2 class="section-title reveal">Ask a funder to sponsor your Diagnostic</h2>
        <p class="reveal">Many funders set aside capacity-building money, and philanthropy groups such as Exponent Philanthropy encourage funders to pay for consultant-led organizational assessments for the organizations they support. A Diagnostic is a concrete, bounded request: a fixed price, a clear deliverable, and results you can share with the funder.</p>
        <ol class="bullet-list reveal">
          <li>Copy the letter below and fill in the brackets.</li>
          <li>Send it to a program officer who knows your work.</li>
          <li><a href="/#contact">Tell me</a> you've asked. I can join a call with the funder if that helps.</li>
        </ol>
        <div class="funder-letter reveal">
          <pre id="funder-letter-text">{FUNDER_LETTER}</pre>
          <div class="hero-ctas">
            <button type="button" class="btn btn-secondary" id="copy-funder-letter" data-track="funder_letter_copy">Copy the Letter</button>
            <a class="btn btn-ghost" id="email-funder-letter" href={`mailto:?subject=${encodeURIComponent('Capacity-building request: organizational diagnostic')}&body=${encodeURIComponent(FUNDER_LETTER)}`} data-track="funder_letter_email">Open in Email</a>
            <span class="form-status" id="copy-status" role="status" aria-live="polite"></span>
          </div>
        </div>

        <div class="cohort-offer reveal" id="funder-cohort">
          <p class="offering-badge">For funders</p>
          <h3>Sponsor a Diagnostic cohort for your grantees</h3>
          <p>Five to ten grantees each get a confidential Diagnostic, a written memo, a 90-day plan, and a six-month reassessment. Your foundation gets an anonymized portfolio report showing the most common constraints across the cohort, plus a shared learning session. No grantee's individual results are shared without its permission.</p>
          <p class="price">From $15,000<span>for a cohort of five, including the portfolio report</span></p>
          <div class="hero-ctas">
            <a class="btn btn-primary plan-cta" href="/?plan=InstitutionalOS+Diagnostic#contact" data-plan="InstitutionalOS Diagnostic" data-track="cohort_inquiry">Discuss a Cohort</a>
            <a class="btn btn-secondary" href="/assets/docs/funder-cohort-overview.pdf" download data-track="overview_download" data-doc="funder">Download the Funder Overview (PDF)</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section id="faq" class="section faq">
      <div class="container narrow">
        <h2 class="section-title reveal">Frequently Asked Questions</h2>
        <div class="faq-list reveal">
          <details>
            <summary>Where does working together start?</summary>
            <p>With a free 30-minute conversation, then the InstitutionalOS Diagnostic: $2,000 for Formation, $2,500 for Grant Readiness or Institutional Durability. It's the single entry point for every paid engagement.</p>
          </details>
          <details>
            <summary>What do I get from the diagnostic?</summary>
            <p>All seven Health Index dimensions scored against your stage's benchmarks, a written memo naming your single binding constraint, a 90-Day Improvement Plan with owners and dates, a live readout session, and a private client portal where your team logs weekly check-ins. The 90-day review and six-month reassessment are scheduled before we close. <a href="#sample-diagnostic">See a sample</a>.</p>
          </details>
          <details>
            <summary>What documents will I need to share?</summary>
            <p>For Grant Readiness, financial health is scored from your public IRS Form 990 filings, so you don't need to send them. For any diagnostic, you can choose to share governance policies, board materials, financial statements, or strategic plans to support the evidence review.</p>
          </details>
          <details>
            <summary>How is my organization's information handled?</summary>
            <p>What you share is used only to complete your diagnostic. It's never sold or reused for another engagement without your knowledge, and you can ask for shared source materials to be deleted once the engagement ends. See the <a href="/privacy">Privacy Policy</a>.</p>
          </details>
          <details>
            <summary>Is there a minimum commitment?</summary>
            <p>The advisory retainer has a three-month recommended minimum. Executive coaching is $350 per 60-minute session, scheduled as needed with no minimum.</p>
          </details>
          <details>
            <summary>Is this legal or accounting advice?</summary>
            <p>No. Where a finding touches legal, accounting, or safeguarding matters, you'll get a recommendation to bring in the right specialist rather than a substitute opinion.</p>
          </details>
          <details>
            <summary>We're not ready to pay for a diagnostic. Where should we start?</summary>
            <p>Take one of the <a href="/tools">free tools</a>. The 7-minute self-assessment covers all seven dimensions and points you to your likely constraint. Every tool you take after that adds to <a href="/health-index">your Health Index</a>, one profile you can print for your board.</p>
          </details>
          <details>
            <summary>How do I make the case to my board?</summary>
            <p>Print your free <a href="/health-index">Health Index</a> and bring it to your next board meeting. It shows all seven dimensions on one page, along with your likely constraint. Your board chair is welcome at the diagnostic's readout session. Some funders also offer capacity-building grants that can cover outside consulting, so ask your program officers.</p>
          </details>
          <details>
            <summary>How are the free tools scored?</summary>
            <p>Every tool uses the same seven dimensions and the same evidence rubric, from "not in place" to "verified." Each question and its research source is published on <a href="/methodology">How Scoring Works</a>.</p>
          </details>
          <details>
            <summary>Can a funder pay for the Diagnostic?</summary>
            <p>Yes. Many funders support capacity building, and the fixed price makes it an easy request. <a href="#funder-sponsored">Use the sponsorship letter</a>, and the invoice can go directly to the funder.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="section closing-cta alt-bg">
      <div class="container narrow center">
        <h2 class="reveal">Not sure which option fits?</h2>
        <p class="reveal">A 30-minute conversation is the fastest way to find the right scope. Or start free: score your organization first and bring your Health Index to the call.</p>
        <div class="hero-ctas center reveal">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener" data-track="schedule_click">Schedule a Strategy Conversation</a>
          <a class="btn btn-secondary" href="/tools" data-track="tool_start">Score Your Organization Free</a>
        </div>
      </div>
    </section>
  </main>

  <ScrollReveal />
</BaseLayout>

<script>
  import { getStage } from '../scripts/pathway';

  // Diagnostic stage toggle (Build / Fund / Sustain). Starts on the stage
  // the visitor chose in any free tool, or Fund; the choice is remembered.
  (function stageToggle() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.stage-tab'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-stage-panel]'));
    if (!tabs.length) return;
    const fromHash = ['build', 'fund', 'sustain'].find((k) => location.hash === '#' + k);
    const show = (k: string) => {
      tabs.forEach((t) => { const on = t.dataset.stage === k; t.setAttribute('aria-selected', String(on)); t.classList.toggle('is-active', on); });
      panels.forEach((p) => { p.hidden = p.dataset.stagePanel !== k; });
    };
    show(fromHash || getStage() || 'fund');
    tabs.forEach((t) => t.addEventListener('click', () => {
      const k = t.dataset.stage!;
      show(k);
      try { localStorage.setItem('fi_stage', k); } catch { /* still works */ }
      (window as any).fiTrack?.('stage_selected', { stage: k, tool: 'consulting' });
    }));
  })();

  // Highlight the recommended tier when arriving from a tool's results.
  (function highlightRecommendedTier() {
    const hash = window.location.hash.replace('#', '');
    if (hash !== 'pricing-advisory' && hash !== 'pricing-implementation') return;
    const targetCard = document.getElementById(hash);
    if (!targetCard) return;
    targetCard.classList.add('is-recommended');
    const badge = targetCard.querySelector<HTMLElement>('.recommended-badge');
    if (badge) badge.hidden = false;
  })();

  // Funder letter: copy to clipboard.
  document.getElementById('copy-funder-letter')?.addEventListener('click', async () => {
    const text = document.getElementById('funder-letter-text')?.textContent || '';
    const status = document.getElementById('copy-status');
    try {
      await navigator.clipboard.writeText(text);
      if (status) status.textContent = 'Copied.';
    } catch {
      if (status) status.textContent = 'Select the letter above and copy it.';
    }
  });
</script>
