---
import { CALENDLY_URL } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import EmailResultsForm from '../components/EmailResultsForm.astro';
import { DIMENSIONS } from '../data/questionBank';
---

<BaseLayout
  title="Your Health Index | Frankly Inspired"
  description="Your combined InstitutionalOS Health Index: every free Frankly Inspired tool you've taken, rolled into one score on the seven dimensions the paid diagnostic uses."
  footerVariant="score"
>
  <Header variant="full" />

  <main id="main">
    <section class="section assessment-intro">
      <div class="container narrow center">
        <p class="eyebrow eyebrow-dark">InstitutionalOS Health Index</p>
        <h1>Your Health Index</h1>
        <p class="hero-sub-light">Every free tool you take adds to one profile on the same seven dimensions the paid diagnostic uses. Each dimension is the average of every answer you've given that maps to it. Your profile is saved only in this browser.</p>
      </div>
    </section>

    <section class="section alt-bg">
      <div class="container narrow">

        <div id="hi-empty" class="hi-empty" hidden>
          <h2 class="subhead">You haven't scored any dimensions yet</h2>
          <p>Start with the free self-assessment. It covers all seven dimensions in about 7 minutes, and every deeper tool you take afterward sharpens the same profile.</p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href="/assessment" data-track="tool_start" data-tool="self-assessment">Start the Free Check-up</a>
            <a class="btn btn-secondary" href="/tools">See All Free Tools</a>
          </div>
        </div>

        <div id="hi-profile" hidden>
          <div class="hi-org" id="hi-org"></div>

          <div class="results-score">
            <span class="results-score-num" id="hi-score"></span>
            <span class="results-score-band" id="hi-band"></span>
          </div>
          <p class="results-band-desc" id="hi-coverage"></p>
          <p class="hi-progress" id="hi-progress" hidden></p>

          <h2 class="subhead">By dimension</h2>
          <div class="hi-dims" id="hi-dims">
            {DIMENSIONS.map((d) => (
              <div class="hi-dim" data-dim={d.key}>
                <div class="hi-dim-head">
                  <a class="results-bar-label" href={`/consulting#${d.anchor}`}>{d.num}. {d.label}</a>
                  <span class="results-bar-pct" data-dim-pct></span>
                </div>
                <span class="results-bar-track"><span class="results-bar-fill" data-dim-fill></span></span>
                <p class="hi-dim-meta" data-dim-meta></p>
              </div>
            ))}
          </div>

          <div class="hi-seal" id="hi-seal"></div>

          <div class="results-recommendation" id="hi-recommendation"></div>

          <!-- Ask about your results: answers grounded only in this page's
               scores (backend /api/ask). Nothing is stored. -->
          <div class="hi-ask" id="hi-ask">
            <h2 class="subhead">Ask about your results</h2>
            <p>Ask anything about your scores: what to fix first, how two dimensions connect, or what your board will ask. Answers use only your scores, never your organization's name.</p>
            <div class="hi-ask-suggest">
              <button type="button" class="chip" data-q="What should we work on first, and why?">What should we work on first?</button>
              <button type="button" class="chip" data-q="What will a funder notice first in these scores?">What will a funder notice?</button>
              <button type="button" class="chip" data-q="How do I explain these results to my board?">How do I explain this to my board?</button>
              <button type="button" class="chip" data-q="What would it take to reach the next Candid Seal level?">How do we reach the next Seal?</button>
            </div>
            <form class="hi-ask-form" id="hi-ask-form" novalidate>
              <label class="visually-hidden" for="hi-ask-q">Your question</label>
              <input type="text" id="hi-ask-q" maxlength="500" placeholder="Type a question about your results" autocomplete="off" />
              <button type="submit" class="btn btn-primary">Ask</button>
            </form>
            <div class="hi-ask-answer" id="hi-ask-answer" aria-live="polite" hidden></div>
            <p class="hi-ask-note">AI-generated from your self-reported scores; not legal, tax, or financial advice. For a verified read, <a href="/consulting#pricing">see the Diagnostic</a>.</p>
          </div>

          <div class="hi-recheck">
            <h2 class="subhead">Re-check in 90 days</h2>
            <p>Your answers are saved in this browser. Retake the tools in 90 days and this page will show what moved since today.</p>
            <div class="hero-ctas">
              <a class="btn btn-secondary" id="hi-gcal" href="#" target="_blank" rel="noopener" data-track="recheck_reminder">Add to Google Calendar</a>
              <button type="button" class="btn btn-secondary" id="hi-ics" data-track="recheck_reminder">Download Calendar Reminder (.ics)</button>
            </div>
            <form class="hi-remind-form" id="hi-remind-form" novalidate>
              <label for="hi-remind-email">Or get one email reminder in 90 days</label>
              <div class="results-email-row">
                <input type="email" id="hi-remind-email" placeholder="Email address" required />
                <button type="submit" class="btn btn-secondary" data-track="recheck_reminder">Remind Me</button>
              </div>
              <p class="results-email-consent">Sent once, then your address is deleted. Nothing else.</p>
              <p class="form-status" id="hi-remind-status" role="status" aria-live="polite"></p>
            </form>
          </div>

          <div class="results-disclaimer">
            <p>An indicative, self-reported reading, not a verified score. Verified Health Index scores come from the InstitutionalOS Diagnostic, which checks the evidence behind each answer. <a href="/methodology">How scoring works</a>.</p>
          </div>

          <EmailResultsForm id="hi-email" />

          <div class="hi-actions">
            <button type="button" class="btn btn-secondary" id="hi-print">Print or Save as PDF for Your Board</button>
            <button type="button" class="results-retake" id="hi-clear">Clear my saved answers</button>
          </div>
        </div>
      </div>
    </section>

    <section class="section closing-cta">
      <div class="container narrow center">
        <h2>Want the verified version?</h2>
        <p>The InstitutionalOS Diagnostic checks the evidence behind every dimension, names your binding constraint in a written memo, and ends with a 90-Day Improvement Plan.</p>
        <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener" data-track="schedule_click">Schedule a Conversation</a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { dimensionScores, loadProfile, clearProfile, FILL_TOOL, progress, sealSummary } from '../scripts/healthEngine';
  import { LEVELS } from '../data/candidSeal';
  import { renderPathway } from '../scripts/pathway';
  import { mountOrgLookup } from '../scripts/orgLookup';
  import { TOOLS } from '../data/questionBank';

  const BANDS = [
    { max: 30, name: 'Foundational' },
    { max: 55, name: 'Developing' },
    { max: 80, name: 'Strengthening' },
    { max: 101, name: 'Resilient' },
  ];
  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c] as string));

  function render() {
    const profile = loadProfile();
    const dims = dimensionScores(profile);
    const covered = dims.filter((d) => d.pct !== null);
    const empty = document.getElementById('hi-empty') as HTMLElement;
    const wrap = document.getElementById('hi-profile') as HTMLElement;
    empty.hidden = covered.length > 0;
    wrap.hidden = covered.length === 0;
    if (!covered.length) return;

    const overall = Math.round(covered.reduce((s, d) => s + (d.pct as number), 0) / covered.length);
    const band = BANDS.find((b) => overall <= b.max)!.name;
    const answers = covered.reduce((s, d) => s + d.count, 0);
    const toolNames = Object.keys(profile.tools).map((k) => TOOLS.find((t) => t.key === k)?.name || k);
    document.getElementById('hi-score')!.textContent = overall + '%';
    document.getElementById('hi-band')!.textContent = band;
    document.getElementById('hi-coverage')!.textContent =
      `${covered.length} of 7 dimensions scored, from ${answers} answer${answers === 1 ? '' : 's'} across ${toolNames.length} tool${toolNames.length === 1 ? '' : 's'}: ${toolNames.join(', ')}.` +
      (covered.length < 7 ? ' The overall score averages only the dimensions scored so far.' : '');

    dims.forEach((d) => {
      const row = document.querySelector<HTMLElement>(`.hi-dim[data-dim="${d.key}"]`);
      if (!row) return;
      const pctEl = row.querySelector<HTMLElement>('[data-dim-pct]')!;
      const fill = row.querySelector<HTMLElement>('[data-dim-fill]')!;
      const meta = row.querySelector<HTMLElement>('[data-dim-meta]')!;
      row.classList.toggle('is-empty', d.pct === null);
      if (d.pct === null) {
        const t = FILL_TOOL[d.key];
        pctEl.textContent = '–';
        fill.style.width = '0';
        meta.innerHTML = `Not scored yet. <a class="link-more" href="${t.href}">Score it with the ${esc(t.name)} &rarr;</a>`;
      } else {
        pctEl.textContent = d.pct + '%';
        fill.style.width = d.pct + '%';
        meta.textContent = `From ${d.count} answer${d.count === 1 ? '' : 's'}: ${d.tools.join(', ')}`;
      }
    });

    // Progress since the first saved check.
    const pr = progress(profile);
    const prEl = document.getElementById('hi-progress') as HTMLElement;
    const fmtDate = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
    if (pr) {
      const moves = dims.filter((d) => typeof pr.change[d.key] === 'number' && pr.change[d.key] !== 0)
        .map((d) => `${d.label} ${(pr.change[d.key] as number) > 0 ? '+' : ''}${pr.change[d.key]}`);
      prEl.hidden = false;
      prEl.innerHTML = `<strong>Since your first check on ${fmtDate(pr.since)}:</strong> ` +
        (moves.length ? esc(moves.join(' · ')) + ' points.' : 'no change yet.') +
        (pr.sealTo && pr.sealTo !== pr.sealFrom ? ` Candid Seal: ${esc(pr.sealFrom ? LEVELS.find((l) => l.key === pr.sealFrom)!.name : 'none')} to ${esc(LEVELS.find((l) => l.key === pr.sealTo)!.name)}.` : '');
      dims.forEach((d) => {
        const c = pr.change[d.key];
        const meta = document.querySelector<HTMLElement>(`.hi-dim[data-dim="${d.key}"] [data-dim-meta]`);
        if (meta && typeof c === 'number' && c !== 0) meta.textContent += ` · ${c > 0 ? '+' : ''}${c} since ${fmtDate(pr.since)}`;
      });
    } else prEl.hidden = true;

    // Candid Seal path.
    const seal = sealSummary(profile);
    const sealEl = document.getElementById('hi-seal')!;
    const ladder = (cur: string | null) => {
      const ci = cur ? LEVELS.findIndex((l) => l.key === cur) : -1;
      return `<div class="seal-ladder">${LEVELS.map((l, i) => `<span class="seal-step${i <= ci ? ' is-done' : ''}">${l.name}</span>`).join('<span class="seal-arrow" aria-hidden="true">&rarr;</span>')}</div>`;
    };
    sealEl.innerHTML = seal
      ? `<h2 class="subhead">Your Candid Seal path</h2>${ladder(seal.current)}
         <p>${seal.current ? `You qualify for <strong>${esc(seal.currentName)}</strong>.` : 'You don\'t qualify for a Seal yet.'} ${seal.next ? `Next up: <strong>${esc(seal.nextName)}</strong>.` : 'Keep Platinum by updating your profile every year.'} <a class="link-more" href="/candid-seal">See your steps &rarr;</a></p>`
      : `<h2 class="subhead">Your Candid Seal path</h2>${ladder(null)}
         <p>Candid's free Seals of Transparency (Bronze to Platinum) are what funders check, and in Candid's research Seal holders received about 62% more in contributions. The same work raises your Health Index. <a class="link-more" href="/candid-seal">Find your path to Platinum &rarr;</a></p>`;

    // 90-day re-check reminder.
    const due = new Date(Date.now() + 90 * 864e5);
    const ymd = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '');
    const end = new Date(due.getTime() + 864e5);
    const title = 'Re-check our Health Index and Candid Seal';
    const details = 'Retake the free tools at https://franklyinspired.associates/tools, review https://franklyinspired.associates/health-index, and update your Candid profile.';
    (document.getElementById('hi-gcal') as HTMLAnchorElement).href =
      `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(title)}&dates=${ymd(due)}/${ymd(end)}&details=${encodeURIComponent(details)}`;
    const ics = document.getElementById('hi-ics')!;
    ics.onclick = () => {
      const body = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Frankly Inspired//Health Index//EN', 'BEGIN:VEVENT',
        `UID:${Date.now()}@franklyinspired.associates`, `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').slice(0, 15)}Z`,
        `DTSTART;VALUE=DATE:${ymd(due)}`, `DTEND;VALUE=DATE:${ymd(end)}`, `SUMMARY:${title}`, `DESCRIPTION:${details}`,
        'END:VEVENT', 'END:VCALENDAR'].join('\r\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([body], { type: 'text/calendar' }));
      a.download = 'health-index-recheck.ics';
      a.click();
    };

    renderPathway(document.getElementById('hi-recommendation'), {
      tool: 'InstitutionalOS Health Index',
      items: covered.map((d) => ({ label: d.label, pct: d.pct as number })),
      compositePct: overall,
      basis: 'answers',
      coversAllSeven: covered.length === 7,
      profile: false,
    });

    (window as any).__fiLastResults = {
      tool: 'health-index',
      scorePct: overall,
      band,
      pillarScores: covered.map((d) => ({ label: d.label, pct: d.pct })),
    };
  }

  render();
  mountOrgLookup(document.getElementById('hi-org'));

  const API = 'https://frankly-inspired-api.onrender.com';

  // ---------- Ask about your results ----------
  (function askAssistant() {
    const form = document.getElementById('hi-ask-form') as HTMLFormElement | null;
    const input = document.getElementById('hi-ask-q') as HTMLInputElement | null;
    const out = document.getElementById('hi-ask-answer') as HTMLElement | null;
    if (!form || !input || !out) return;
    const ask = (q: string) => {
      const profile = loadProfile();
      const scores = dimensionScores(profile).filter((d) => d.pct !== null).map((d) => ({ label: d.label, pct: d.pct as number }));
      if (!scores.length) return;
      const seal = sealSummary(profile);
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      out.hidden = false;
      out.innerHTML = `<p class="hi-ask-q">${esc(q)}</p><p class="dim">Thinking...</p>`;
      if (btn) btn.disabled = true;
      fetch(API + '/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          question: q,
          scores,
          seal: seal ? seal.current : null,
          stage: (() => { try { return localStorage.getItem('fi_stage'); } catch { return null; } })(),
        }),
      })
        .then((r) => r.json().then((d) => ({ ok: r.ok, d })))
        .then(({ ok, d }) => {
          if (!ok || !d.ok) throw new Error((d && d.error) || 'The assistant is unavailable right now.');
          out.innerHTML = `<p class="hi-ask-q">${esc(q)}</p>` + String(d.answer).split(/\n{2,}/).map((p: string) => `<p>${esc(p)}</p>`).join('');
          (window as any).fiTrack?.('results_question', {});
        })
        .catch((e) => { out.innerHTML = `<p class="hi-ask-q">${esc(q)}</p><p>${esc(e.message)} You can also <a href="https://calendly.com/fparham/30min" target="_blank" rel="noopener">ask Franklin directly</a>.</p>`; })
        .finally(() => { if (btn) btn.disabled = false; });
    };
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (q.length >= 3) { ask(q); input.value = ''; }
    });
    document.querySelectorAll<HTMLButtonElement>('.hi-ask-suggest .chip').forEach((b) => b.addEventListener('click', () => ask(b.dataset.q || b.textContent || '')));
  })();

  // ---------- One-time 90-day email reminder ----------
  document.getElementById('hi-remind-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const input = document.getElementById('hi-remind-email') as HTMLInputElement;
    const status = document.getElementById('hi-remind-status');
    if (!input.checkValidity()) { input.reportValidity(); return; }
    if (status) status.textContent = 'Saving...';
    fetch(API + '/api/reminders', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: input.value, tool: 'health-index' }) })
      .then((r) => r.json().then((d) => ({ ok: r.ok, d })))
      .then(({ ok, d }) => {
        if (!ok || !d.ok) throw new Error((d && d.error) || 'Could not save the reminder.');
        if (status) {
          status.textContent = "Done. You'll get one email in 90 days. ";
          const a = document.createElement('a'); a.href = d.cancelUrl; a.textContent = 'Cancel it'; a.target = '_blank'; a.rel = 'noopener';
          status.appendChild(a);
        }
        form.reset();
        (window as any).fiTrack?.('recheck_reminder_email', {});
      })
      .catch((err) => { if (status) status.textContent = err.message; });
  });


  document.getElementById('hi-print')?.addEventListener('click', () => window.print());
  document.getElementById('hi-clear')?.addEventListener('click', () => {
    clearProfile();
    try { localStorage.removeItem('fi_stage'); } catch { /* ignore */ }
    render();
  });
</script>
