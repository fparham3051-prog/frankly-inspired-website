---
import { SCORECARD_URL, CALENDLY_URL } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import RubricKey from '../components/RubricKey.astro';
import QuestionSection from '../components/QuestionSection.astro';
---

<BaseLayout
  title="Free Check-up: Nonprofit Sustainability Self-Assessment | Frankly Inspired"
  description="A free, 21-question self-assessment that scores your nonprofit on all seven InstitutionalOS Health Index dimensions by the evidence you could show, then names your likely constraint and a 90-day action."
  footerVariant="assessment"
>
  <Header variant="minimal" />

  <main id="main">

    <!-- ============ INTRO ============ -->
    <section class="section assessment-intro">
      <div class="container narrow center">
        <p class="eyebrow eyebrow-dark">7 minutes &middot; No sign-up</p>
        <h1>Free Check-up</h1>
        <p class="hero-sub-light">21 short questions about how your organization actually runs, about 7 minutes. For each one, pick what you could show evidence for, not what you hope is true. You'll see your score, the area most likely to break first, and a first step for the next 90 days. Your answers stay in your browser unless you choose to email yourself the results.</p>
      </div>
    </section>

    <!-- ============ ASSESSMENT FORM ============ -->
    <section class="section assessment-form-section alt-bg">
      <div class="container narrow">

        <!-- Sticky progress indicator, kept in sync with which pillar-group
             is in view. Hidden automatically once results are shown (no
             form left to track progress through). -->
        <div class="assessment-progress" id="assessment-progress">
          <p class="assessment-progress-label" id="assessment-progress-label">Section 1 of 7: Sustainability Strategy</p>
          <span class="assessment-progress-track"><span class="assessment-progress-fill" id="assessment-progress-fill"></span></span>
        </div>

        <form id="assessment-form" novalidate>
          <RubricKey />

          <QuestionSection tool="self-assessment" index={1} />

          <QuestionSection tool="self-assessment" index={2} />

          <QuestionSection tool="self-assessment" index={3} />

          <QuestionSection tool="self-assessment" index={4} />

          <QuestionSection tool="self-assessment" index={5} />

          <QuestionSection tool="self-assessment" index={6} />

          <QuestionSection tool="self-assessment" index={7} />

          <div class="assessment-submit">
            <button type="submit" class="btn btn-primary">See My Results</button>
            <p class="form-status" id="assessment-status" role="status" aria-live="polite"></p>
          </div>
        </form>

        <!-- ============ RESULTS (rendered by the script below) ============ -->
        <div class="assessment-results" id="assessment-results" hidden>
          <div class="results-score">
            <span class="results-score-num" id="results-score-num"></span>
            <span class="results-score-band" id="results-score-band"></span>
          </div>
          <p class="results-band-desc" id="results-band-desc"></p>
          <p class="results-avg-overall" id="results-avg-overall" hidden></p>
          <p class="results-narrative-loading" id="results-narrative-loading" hidden>Writing a personalized summary of your results&hellip;</p>

          <h3 class="subhead">By Pillar</h3>
          <div class="results-bars" id="results-bars"></div>

          <div class="results-priority" id="results-priority"></div>

          <div class="results-recommendation" id="results-recommendation"></div>

          <div class="results-disclaimer">
            <p>This is a directional self-assessment based on your own responses, not a formal audit or guarantee of any outcome. It's meant to help you think through your organization's sustainability posture and where to focus next.</p>
          </div>

          <div class="results-related">
            <p>Several of these areas also have a deeper, dedicated tool if you want to go further: the <a href="/leadership-health">Leadership &amp; Operations Score</a> (governance and succession research) and the <a href="/sustainability-score">Sustainability Strategy Score</a>, which blends the others into one strategic view. Revenue Diversification has two: the <a href="/revenue-growth-score">Revenue &amp; Growth Score</a> (real budget numbers against sector benchmarks) and the <a href="/institutional-advancement-score">Institutional Advancement Score</a> (the fundraising program behind those numbers: gift portfolios, stewardship, campaigns, and events).</p>
            <p>This assessment covers all seven Health Index dimensions from your own answers. For a second read built from a description of your organization, try the <a href={SCORECARD_URL}>Quick Check-up</a>.</p>
          </div>

          <div class="results-cta">
            <h3>Not sure where to start?</h3>
            <p>A short conversation is the fastest way to turn this into a plan.</p>
            <div class="hero-ctas center">
              <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Schedule a Conversation</a>
              <a class="btn btn-secondary" href="/consulting#pricing">See Pricing</a>
            </div>
          </div>

          <div id="score-ref-cta" class="score-ref-cta" hidden></div>

          <form class="results-email-form" id="results-email-form" novalidate>
            <div class="hp-field" aria-hidden="true">
              <label for="hp_field_assessment">Leave this field blank</label>
              <input type="text" id="hp_field_assessment" name="hp_field" tabindex="-1" autocomplete="off" />
            </div>
            <label for="results-email">Want these results emailed to you?</label>
            <div class="results-email-row">
              <input type="email" id="results-email" name="email" placeholder="Email address" required />
              <button type="submit" class="btn btn-secondary">Email My Results</button>
            </div>
            <label class="results-email-remind"><input type="checkbox" id="results-email-remind" /> Also send me one reminder in 90 days to re-check my progress</label>
            <p class="results-email-consent">Franklin may follow up personally about your results. No mailing list; a reminder is sent once, then your address is deleted.</p>
            <p class="form-status" id="email-status" role="status" aria-live="polite"></p>
          </form>

          <button type="button" class="results-retake" id="results-retake">Retake the Assessment</button>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<script>
  import { renderPathway } from '../scripts/pathway';
  import { enableStepper } from '../scripts/stepper';
  import { mountTriggerPicker, getTrigger } from '../scripts/trigger';
  mountTriggerPicker(document.getElementById('assessment-form') as HTMLFormElement | null, 'self-assessment');
  enableStepper(document.getElementById('assessment-form') as HTMLFormElement | null);
  import { recordAnswers, loadProfile, sealSummary } from '../scripts/healthEngine';
  import { TOOLS } from '../data/questionBank';
  // Scoring runs entirely in the browser (no data leaves the page) except
  // two backend calls: an anonymized score log + AI narrative request on
  // completion, and the optional "email me my results" capture at the end.
  // UPDATE THIS once frankly-inspired-backend is deployed to Render, same
  // value as index.astro's API_BASE.
  const API_BASE = 'https://frankly-inspired-api.onrender.com';

  let lastResults: {
    scorePct: number;
    band: string;
    pillarScores: { label: string; pct: number }[];
    narrative?: string;
  } | null = null;

  // Pillar definitions. "service" text is copied verbatim from the
  // Consulting section on index.astro, keep in sync if that copy ever
  // changes. "anchor" points at the matching Service Pillar card's id, so
  // results link straight to that specific service instead of the general
  // Consulting section. "deepDive", where present, points at the dedicated
  // numbers/research-grounded diagnostic for that same pillar, this quick
  // 21-question assessment and that deeper tool share a pillar name on
  // purpose (quick version / deep version of the same area), so the
  // priority-area callout below makes that relationship explicit instead
  // of leaving a visitor to discover a same-named tool on their own.
  const PILLARS = [
    {
      num: 1,
      label: 'Sustainability Strategy',
      service: 'Organizational assessment, strategic priorities, risk identification, sustainability roadmaps, and implementation planning.',
      anchor: 'pillar-sustainability',
      deepDive: [{ href: '/sustainability-score', label: 'Sustainability Strategy Score' }],
    },
    {
      num: 2,
      label: 'Revenue Diversification',
      service: 'Fundraising strategy, partnership development, grant and public-funding strategy, sponsorship thinking, and revenue-pipeline design.',
      anchor: 'pillar-revenue',
      deepDive: [
        { href: '/revenue-growth-score', label: 'Revenue & Growth Score' },
        { href: '/institutional-advancement-score', label: 'Institutional Advancement Score' },
      ],
    },
    {
      num: 3,
      label: 'Leadership & Organizational Development',
      service: 'Executive advising, leadership systems, role clarity, performance expectations, staff alignment, and change leadership.',
      anchor: 'pillar-leadership',
      deepDive: [{ href: '/leadership-health', label: 'Leadership & Operations Score' }],
    },
    {
      num: 4,
      label: 'Operations & Infrastructure',
      service: 'Workflows, KPIs, dashboards, CRM/Salesforce practices, accountability systems, planning rhythms, and execution.',
      anchor: 'pillar-operations',
      deepDive: [],
    },
    {
      num: 5,
      label: 'Partnership & Ecosystem Strategy',
      service: 'Education, workforce, government, corporate, philanthropic, and community partnership development.',
      anchor: 'pillar-partnership',
      deepDive: [],
    },
    {
      num: 6,
      label: 'Program & Impact Evidence',
      service: 'Logic models, outcome measurement, and evidence of results that funders and boards trust.',
      anchor: 'pillar-program',
      deepDive: [],
    },
    {
      num: 7,
      label: 'Governance & Risk',
      service: 'Board practice, core policies, Form 990 governance, executive oversight, and the risks a funder will ask about.',
      anchor: 'pillar-governance',
      deepDive: [
        { href: '/leadership-health', label: 'Leadership & Operations Score' },
        { href: '/sustainability-score', label: 'Sustainability Strategy Score' },
      ],
    },
  ];

  // recommendedTier maps to a specific pricing card id on index.astro
  // (#pricing-implementation or #pricing-advisory) so the results page can
  // deep-link to the specific retainer that best matches this score band.
  const BANDS = [
    { max: 30, name: 'Foundational', desc: "This is a common starting point, and exactly where a focused strategy makes the most difference. The priority area below is where to start.", recommendedTier: 'implementation', tierName: 'Advisory and Implementation Retainer', tierReason: 'with this many areas to build at once, weekly hands-on support tends to move faster than periodic advisory alone.' },
    { max: 55, name: 'Developing', desc: 'Some structure is in place, but meaningful gaps remain in one or more areas. Closing them is very achievable with the right focus.', recommendedTier: 'implementation', tierName: 'Advisory and Implementation Retainer', tierReason: 'closing gaps across more than one pillar usually benefits from hands-on implementation, not just advisory guidance.' },
    { max: 80, name: 'Strengthening', desc: "A solid foundation is in place. The opportunity now is to sharpen and connect what's already working.", recommendedTier: 'advisory', tierName: 'Advisory and Implementation Retainer', tierReason: 'with a solid foundation already in place, experienced strategic guidance is usually enough to sharpen it further.' },
    { max: 101, name: 'Resilient', desc: 'A strong sustainability posture. The opportunity now is to protect it and extend it as the organization grows.', recommendedTier: 'advisory', tierName: 'Advisory and Implementation Retainer', tierReason: 'a strong foundation like this usually just needs a periodic strategic thought partner to protect and extend it.' },
  ];

  const form = document.getElementById('assessment-form') as HTMLFormElement | null;
  const status = document.getElementById('assessment-status');
  const resultsEl = document.getElementById('assessment-results') as HTMLElement | null;
  const barsEl = document.getElementById('results-bars');
  const priorityEl = document.getElementById('results-priority');
  const bandDescEl = document.getElementById('results-band-desc');
  const narrativeLoadingEl = document.getElementById('results-narrative-loading') as HTMLElement | null;

  /* ---------- Sticky progress bar ---------- */
  const progressEl = document.getElementById('assessment-progress') as HTMLElement | null;
  const progressLabel = document.getElementById('assessment-progress-label');
  const progressFill = document.getElementById('assessment-progress-fill') as HTMLElement | null;
  const pillarGroups = document.querySelectorAll<HTMLElement>('.pillar-group[data-pillar-index]');

  if (progressEl && progressLabel && progressFill && pillarGroups.length && 'IntersectionObserver' in window) {
    const pillarLabelByIndex: Record<number, string> = {};
    PILLARS.forEach((p) => { pillarLabelByIndex[p.num] = p.label; });

    const progressObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = Number(entry.target.getAttribute('data-pillar-index'));
            progressLabel.textContent = `Section ${idx} of ${pillarGroups.length}: ${pillarLabelByIndex[idx] || ''}`;
            progressFill.style.width = (idx / pillarGroups.length) * 100 + '%';
          }
        });
      },
      { rootMargin: '-15% 0px -70% 0px' }
    );

    pillarGroups.forEach((group) => progressObserver.observe(group));
  }

  function pillarScore(num: number, formEl: HTMLFormElement): number {
    let total = 0;
    for (let q = 1; q <= 3; q++) {
      const checked = formEl.querySelector<HTMLInputElement>(`input[name="p${num}q${q}"]:checked`);
      total += checked ? Number(checked.value) : 0;
    }
    return total; // 3-15
  }

  function bandFor(pct: number) {
    for (let i = 0; i < BANDS.length; i++) {
      if (pct <= BANDS[i].max) return BANDS[i];
    }
    return BANDS[BANDS.length - 1];
  }

  function renderResults(pillarScores: { num: number; label: string; service: string; anchor: string; deepDive: { href: string; label: string }[]; score: number }[]) {
    // Each area is 3 questions scored 1-5 (3-15). Composite runs from 3n
    // to 15n for n areas, mapped to 0-100% (evidence rubric: 0/25/50/75/100).
    const n = pillarScores.length;
    const composite = pillarScores.reduce((sum, p) => sum + p.score, 0);
    const pct = Math.round(((composite - 3 * n) / (12 * n)) * 100);
    const band = bandFor(pct);

    const scoreNumEl = document.getElementById('results-score-num');
    const scoreBandEl = document.getElementById('results-score-band');
    if (scoreNumEl) scoreNumEl.textContent = pct + '%';
    if (scoreBandEl) scoreBandEl.textContent = band.name;
    if (bandDescEl) bandDescEl.textContent = band.desc;

    if (barsEl) {
      barsEl.innerHTML = '';
      pillarScores.forEach((p) => {
        const scaledPct = Math.round(((p.score - 3) / 12) * 100);
        const row = document.createElement('div');
        row.className = 'results-bar-row';
        row.innerHTML =
          `<a class="results-bar-label" href="/consulting#${p.anchor}">${p.label}</a>` +
          '<span class="results-bar-track">' +
          `<span class="results-bar-fill" style="width:${scaledPct}%"></span>` +
          `<span class="results-bar-avg-marker" data-avg-marker="${p.label}" hidden></span>` +
          '</span>' +
          `<span class="results-bar-pct">${scaledPct}%</span>` +
          `<span class="results-bar-avg" data-avg-text="${p.label}"></span>`;
        barsEl.appendChild(row);
      });
    }

    const scoredPillars = pillarScores.map((p) => ({ ...p, pct: Math.round(((p.score - 3) / 12) * 100) }));
    const lowest = scoredPillars.reduce((min, p) => (p.pct < min.pct ? p : min), scoredPillars[0]);

    if (priorityEl) priorityEl.innerHTML = '';
    const deepDiveLinks = lowest.deepDive
      .map((d) => `<a class="link-more" href="${d.href}">${d.label}</a>`)
      .join(' or ');
    if (form) recordAnswers('self-assessment', form, pct);
    renderPathway(document.getElementById('results-recommendation'), {
      tool: 'Nonprofit Sustainability Self-Assessment',
      items: scoredPillars.map((p) => ({ label: p.label, pct: p.pct, help: p.service })),
      compositePct: pct,
      basis: 'answers',
      coversAllSeven: true,
      extraHtml: lowest.deepDive.length
        ? `<p class="section-note">For a deeper read on this area, take the ${deepDiveLinks}.</p>`
        : '',
    });

    lastResults = {
      scorePct: pct,
      band: band.name,
      pillarScores: scoredPillars.map((p) => ({ label: p.label, pct: p.pct })),
    };

    if (form) form.hidden = true;
    if (progressEl) progressEl.hidden = true;
    if (resultsEl) {
      resultsEl.hidden = false;
      resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    fetchNarrative(lastResults);
    fetchBenchmarks(pct);
  }

  /* Benchmark comparison. An enhancement, not a dependency: if the
     database isn't reachable, has no data yet, or the sample is too small
     to be meaningful, the results the visitor already sees are unaffected;
     this just quietly adds a comparison line and tick marks when it can. */
  function fetchBenchmarks(compositePct: number) {
    const overallEl = document.getElementById('results-avg-overall') as HTMLElement | null;

    fetch(API_BASE + '/api/benchmarks?scale=evidence')
      .then((res) => res.json())
      .then((data) => {
        const b = data && data.ok ? data.benchmarks : null;
        if (!b || !b.count) return; // nothing logged yet, say nothing rather than show a zero

        if (overallEl) {
          const lowSample = b.count < 5;
          overallEl.hidden = false;
          overallEl.innerHTML =
            `Your score: <strong>${compositePct}%</strong> &middot; Average so far: <strong>${b.avgScore}%</strong>` +
            (lowSample
              ? ` <span class="results-avg-caveat">(early data: ${b.count} response${b.count === 1 ? '' : 's'} so far)</span>`
              : ` (${b.count} responses)`);
        }

        (b.pillarAverages || []).forEach((avg: { label: string; avgPct: number }) => {
          const marker = document.querySelector<HTMLElement>(`[data-avg-marker="${avg.label}"]`);
          const text = document.querySelector<HTMLElement>(`[data-avg-text="${avg.label}"]`);
          if (marker) {
            marker.hidden = false;
            marker.style.left = avg.avgPct + '%';
          }
          if (text) text.innerHTML = `Avg: <strong>${avg.avgPct}%</strong>`;
        });
      })
      .catch(() => {
        // Silent by design, same reasoning as fetchNarrative below.
      });
  }

  /* AI-generated personalized summary. An enhancement, not a dependency:
     the static band description is already visible from renderResults()
     above, so if this call is slow, fails, or the backend has no
     ANTHROPIC_API_KEY configured, the visitor still has a complete,
     correct set of results; this just quietly upgrades the description
     text if and when a narrative comes back. */
  function fetchNarrative(results: NonNullable<typeof lastResults>) {
    if (narrativeLoadingEl) narrativeLoadingEl.hidden = false;

    fetch(API_BASE + '/api/assessment-narrative', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        scale: 'evidence',
        trigger: getTrigger() || undefined,
        scorePct: results.scorePct,
        band: results.band,
        pillarScores: results.pillarScores,
      }),
    })
      .then((res) => res.json())
      .then((data) => {
        if (data && data.ok && data.narrative) {
          if (bandDescEl) bandDescEl.textContent = data.narrative;
          if (lastResults) lastResults.narrative = data.narrative;
        }
      
        if (data && data.score_ref) {
          const scoreRefCtaEl = document.getElementById('score-ref-cta');
          if (scoreRefCtaEl) {
            scoreRefCtaEl.innerHTML =
              '<a class="btn btn-primary" href="/?score_ref=' +
              encodeURIComponent(data.score_ref) +
              '#contact">Continue to a Conversation &rarr;</a>';
            scoreRefCtaEl.hidden = false;
          }
        }
      })
      .catch(() => {
        // Silent by design, static description already shown, nothing to fix.
      })
      .finally(() => {
        if (narrativeLoadingEl) narrativeLoadingEl.hidden = true;
      });
  }

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        if (status) status.textContent = 'Please answer every question: one is still missing.';
        return;
      }

      const pillarScores = PILLARS.map((p) => ({
        num: p.num,
        label: p.label,
        service: p.service,
        anchor: p.anchor,
        deepDive: p.deepDive,
        score: pillarScore(p.num, form),
      }));

      if (status) status.textContent = '';
      renderResults(pillarScores);
    });
  }

  const retakeBtn = document.getElementById('results-retake');
  if (retakeBtn) {
    retakeBtn.addEventListener('click', () => {
      if (resultsEl) resultsEl.hidden = true;
      if (form) form.hidden = false;
      if (progressEl && progressLabel && progressFill) {
        progressEl.hidden = false;
        progressLabel.textContent = `Section 1 of ${pillarGroups.length}: ${PILLARS[0] ? PILLARS[0].label : ''}`;
        progressFill.style.width = 100 / pillarGroups.length + '%';
      }
      form?.reset();
      form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  const emailForm = document.getElementById('results-email-form') as HTMLFormElement | null;
  const emailStatus = document.getElementById('email-status');
  if (emailForm) {
    emailForm.addEventListener('submit', (e) => {
      e.preventDefault();

      if (!lastResults) {
        if (emailStatus) emailStatus.textContent = 'Please complete the assessment first.';
        return;
      }
      if (!emailForm.checkValidity()) {
        emailForm.reportValidity();
        return;
      }

      const formData = new FormData(emailForm);
      const payload = {
        email: formData.get('email'),
        hp_field: formData.get('hp_field'),
        tool: 'self-assessment',
        trigger: getTrigger() || undefined,
        stage: (() => { try { return localStorage.getItem('fi_stage') || undefined; } catch { return undefined; } })(),
        scorePct: lastResults.scorePct,
        band: lastResults.band,
        pillarScores: lastResults.pillarScores,
        narrative: lastResults.narrative || null,
        org: loadProfile().org || undefined,
        toolsTaken: Object.keys(loadProfile().tools).map((k) => TOOLS.find((t) => t.key === k)?.name || k),
        seal: (() => { const s = sealSummary(); return s ? { current: s.current, next: s.next } : undefined; })(),
        remind: (document.querySelector<HTMLInputElement>('#results-email-remind')?.checked) || false,
      };

      const submitBtn = emailForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (emailStatus) emailStatus.textContent = 'Sending...';
      if (submitBtn) submitBtn.disabled = true;

      fetch(API_BASE + '/api/assessment-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then((res) => res.json().then((data) => ({ ok: res.ok, data })))
        .then((result) => {
          if (!result.ok || !result.data.ok) {
            throw new Error((result.data && result.data.error) || 'Something went wrong.');
          }
          if (emailStatus) {
            emailStatus.textContent = result.data.reminder ? 'Sent, check your inbox. Your 90-day reminder is set. ' : 'Sent, check your inbox.';
            if (result.data.cancelUrl) {
              const a = document.createElement('a');
              a.href = result.data.cancelUrl; a.textContent = 'Cancel the reminder'; a.target = '_blank'; a.rel = 'noopener';
              emailStatus.appendChild(a);
            }
          }
          emailForm.reset();
        })
        .catch((err) => {
          if (emailStatus) emailStatus.textContent = err.message;
        })
        .finally(() => {
          if (submitBtn) submitBtn.disabled = false;
        });
    });
  }
</script>
