---
import { SCORECARD_URL, CALENDLY_URL } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { testimonials, caseStudies } from '../data/proof';
import DurabilityIndex from '../components/DurabilityIndex.astro';
---

<BaseLayout
  title="Franklin D. Parham | Nonprofit Strategy & Sustainability"
  description="Franklin D. Parham helps nonprofit leaders strengthen sustainability through strategy, diversified revenue, organizational development, operations, and cross-sector partnerships."
  footerVariant="home"
>
  <Header variant="full" />

  <main id="main">

    <!-- ============ HERO ============ -->
    <section id="top" class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow reveal" style="margin-bottom:0.35rem;">Franklin D. Parham</p>
          <p class="hero-role reveal">Founder and Principal, Frankly Inspired and Associates</p>
          <h1 class="hero-h1-long reveal">Find the one thing holding your nonprofit back, and a 90-day plan to close the gap.</h1>
          <p class="hero-sub reveal">Evidence-based strategy and sustainability consulting for nonprofit leaders. Every engagement scores your organization, names its single binding constraint, and ends with a plan concrete enough to act on Monday morning.</p>
          <div class="hero-ctas reveal">
            <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener" data-track="schedule_click">Schedule a Strategy Conversation</a>
            <a class="btn btn-secondary" href={SCORECARD_URL} target="_blank" rel="noopener" data-track="hero_scorecard_click">Get Your Free Health Index Score</a>
          </div>
        </div>
        <div class="hero-portrait reveal">
          <img
            src="/assets/images/franklin-parham-headshot.jpg"
            alt="Franklin D. Parham, Founder and Principal of Frankly Inspired and Associates, LLC"
            width="800"
            height="800"
          />
        </div>
      </div>
      <div class="hero-credentials reveal">
        <div class="hero-credential"><span class="hero-credential-num">15+</span><span>Years Leadership Experience</span></div>
        <div class="hero-credential-divider" aria-hidden="true"></div>
        <a class="hero-credential hero-credential-link" href="/consulting#dimensions"><span>7-Dimension Health Index</span></a>
        <div class="hero-credential-divider" aria-hidden="true"></div>
        <a class="hero-credential hero-credential-link" href="/consulting#pricing"><span>Diagnostic from $2,000</span></a>
      </div>
    </section>

    <!-- ============ PROOF ============ -->
    <!-- Verified figures from Franklin's most recent role (keep in sync with
         /about "Impact by the Numbers") plus a live count of free
         assessments completed, which stays hidden until it passes 25. -->
    <section id="track-record" class="section proof-section">
      <div class="container">
        <p class="affiliation-label reveal">Board leadership and affiliations: Ora Lee Smith Cancer Research Foundation &middot; Turner Foundation for Community Advocacy &middot; Howard Rye Institute Fellow &middot; AFP Fellow</p>
        <div class="stat-grid proof-stats">
          <div class="stat stat-live reveal" id="live-stat" hidden><span class="stat-num" id="live-stat-num"></span><span class="stat-label">free nonprofit assessments completed with Frankly Inspired tools</span></div>
          <div class="stat reveal"><span class="stat-num">15+</span><span class="stat-label">years of nonprofit leadership and higher-education advancement</span></div>
          <div class="stat reveal"><span class="stat-num">$1.3M</span><span class="stat-label">in regional operating budgets managed, The Hidden Genius Project</span></div>
          <div class="stat reveal"><span class="stat-num">20+</span><span class="stat-label">cross-sector partnerships built and stewarded</span></div>
          <div class="stat reveal"><span class="stat-num">$500K+</span><span class="stat-label">in scholarships secured, with 100% college enrollment for the senior cohort</span></div>
        </div>
        <p class="reveal" style="margin-top:1rem;"><a class="link-more" href="/about">About Franklin and his full track record &rarr;</a></p>
        <DurabilityIndex compact />
      </div>
    </section>

    {testimonials.length > 0 && (
      <section id="testimonials" class="section testimonials alt-bg">
        <div class="container">
          <h2 class="section-title reveal">What Leaders Say</h2>
          <div class="card-grid">
            {testimonials.map((t) => (
              <figure class="card card-static testimonial reveal">
                <blockquote>&ldquo;{t.quote}&rdquo;</blockquote>
                <figcaption>
                  {t.name && <strong>{t.name}</strong>}
                  <span>{[t.role, t.org].filter(Boolean).join(', ')}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {caseStudies.length > 0 && (
      <section id="case-studies" class="section case-studies">
        <div class="container">
          <h2 class="section-title reveal">Client Results</h2>
          <div class="card-grid">
            {caseStudies.map((c) => (
              <div class="card card-static reveal">
                <span class="offering-badge">{c.stage}</span>
                <h4>{c.org}</h4>
                <p><strong>Constraint:</strong> {c.constraint}</p>
                <p><strong>What we did:</strong> {c.action}</p>
                <p><strong>Result:</strong> {c.result}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============ HOW IT WORKS ============ -->
    <section id="how" class="section how-section alt-bg">
      <div class="container">
        <h2 class="section-title reveal">How it works</h2>
        <p class="section-note reveal">One method, from your first free score to measurable progress.</p>
        <ol class="steps">
          <li class="step reveal">
            <span class="step-num" aria-hidden="true">1</span>
            <h3>Score</h3>
            <p>Take the free tools. Every answer builds one Health Index across seven dimensions, saved in your browser.</p>
            <a class="link-more" href="/tools">Start free &rarr;</a>
          </li>
          <li class="step reveal">
            <span class="step-num" aria-hidden="true">2</span>
            <h3>Verify</h3>
            <p>The Diagnostic checks the evidence behind each score: filed 990s, policies, and practices, not self-reported optimism.</p>
            <a class="link-more" href="/consulting#pricing">See the Diagnostic &rarr;</a>
          </li>
          <li class="step reveal">
            <span class="step-num" aria-hidden="true">3</span>
            <h3>Plan</h3>
            <p>A written memo names your single binding constraint, with a 90-day plan that includes your next Candid Seal level.</p>
            <a class="link-more" href="/consulting#sample-diagnostic">See a sample &rarr;</a>
          </li>
          <li class="step reveal">
            <span class="step-num" aria-hidden="true">4</span>
            <h3>Track</h3>
            <p>Re-score every 90 days. Your Health Index shows what moved, so progress is measured, not just described.</p>
            <a class="link-more" href="/health-index">Your Health Index &rarr;</a>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============ PRODUCT PREVIEW ============ -->
    <!-- Real screenshots of the live tools with a fictional sample
         organization (regenerate with scripts/product-shots.py). -->
    <section id="preview" class="section preview-section">
      <div class="container">
        <h2 class="section-title reveal">See exactly what you get</h2>
        <p class="section-note reveal">Real screens from the tools, shown with a fictional sample organization.</p>
        <div class="preview-grid">
          <figure class="preview reveal">
            <img src="/assets/images/product/health-index.webp" alt="Health Index page showing seven dimension scores for a sample organization, with progress since its first check" width="1200" height="900" loading="lazy" />
            <figcaption><strong>Your Health Index.</strong> All seven dimensions from every tool you take, with progress since your first check. Free.</figcaption>
          </figure>
          <figure class="preview reveal">
            <img src="/assets/images/product/candid-seal.webp" alt="Candid Seal Path results showing the current Seal level and the steps to the next level" width="1200" height="900" loading="lazy" />
            <figcaption><strong>Your Candid Seal path.</strong> Where you stand on Candid's Seals of Transparency and the steps to Platinum. Free.</figcaption>
          </figure>
          <figure class="preview reveal">
            <img src="/assets/images/product/diagnostic-report.webp" alt="InstitutionalOS Diagnostic client report with weighted scores by dimension and the Candid Seal path" width="1200" height="900" loading="lazy" />
            <figcaption><strong>Your Diagnostic report.</strong> Verified scores by dimension, your binding constraint, and a 90-day plan, re-scored over time.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ OFFERS ============ -->
    <section id="offers" class="section offers-section alt-bg">
      <div class="container">
        <h2 class="section-title reveal">Ways to work together</h2>
        <p class="section-note reveal">Every paid engagement starts with the Diagnostic. Full details, a sample report, and the funder-sponsorship letter are on the <a href="/consulting">Consulting page</a>.</p>
        <div class="offer-grid">
          <a class="offer-card reveal" href="/tools" data-track="tool_start">
            <span class="offering-badge">Start here</span>
            <h3>Free tools</h3>
            <p class="offer-price">$0</p>
            <p>Score all seven dimensions, look up your Form 990, and find your Candid Seal path. No sign-up.</p>
            <span class="card-cta">Score your organization &rarr;</span>
          </a>
          <a class="offer-card featured reveal" href="/consulting#pricing">
            <span class="offering-badge">Step 1</span>
            <h3>InstitutionalOS Diagnostic</h3>
            <p class="offer-price">$2,000 to $2,500 <span>by stage</span></p>
            <p>Build, Fund, or Sustain. Verified scores, your binding constraint, a 90-day plan, and a live readout.</p>
            <span class="card-cta">See the Diagnostic &rarr;</span>
          </a>
          <a class="offer-card reveal" href="/consulting#pricing-advisory">
            <span class="offering-badge">Step 2</span>
            <h3>Advisory and Implementation Retainer</h3>
            <p class="offer-price">$2,500 to $3,500 <span>per month</span></p>
            <p>Ongoing support closing the gap the Diagnostic named, or a fixed-scope project.</p>
            <span class="card-cta">See the retainer &rarr;</span>
          </a>
          <a class="offer-card reveal" href="/consulting#coaching">
            <span class="offering-badge">For the leader</span>
            <h3>1:1 Executive Coaching</h3>
            <p class="offer-price">$350 <span>per session</span></p>
            <p>Confidential 60-minute sessions for executive directors and senior leaders. No minimum.</p>
            <span class="card-cta">See coaching &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ FREE TOOLS ============ -->
    <section id="assessments" class="section assessments-section">
      <div class="container">
        <h2 class="section-title reveal">Score your organization for free</h2>
        <div class="card-grid">
          <a class="card reveal featured-tool" href="/assessment" data-track="tool_start" data-tool="self-assessment">
            <span class="offering-badge">7 minutes</span>
            <h4>Sustainability Self-Assessment</h4>
            <p>21 practices across all seven dimensions, scored by the evidence you could show. Builds your Health Index.</p>
            <span class="card-cta">Take the Self-Assessment &rarr;</span>
          </a>
          <a class="card reveal featured-tool" href={SCORECARD_URL} target="_blank" rel="noopener" data-track="tool_start" data-tool="institutionalos-scorecard">
            <span class="offering-badge">2 minutes</span>
            <h4>InstitutionalOS Scorecard</h4>
            <p>Describe your organization in a paragraph and get a score on all seven dimensions from the same system as the Diagnostic.</p>
            <span class="card-cta">Get Your Free Score &rarr;</span>
          </a>
          <a class="card reveal featured-tool" href="/candid-seal" data-track="tool_start" data-tool="candid-seal">
            <span class="offering-badge">5 minutes</span>
            <h4>Candid Seal Path</h4>
            <p>Candid's free Seals of Transparency are how funders check you. Holders received 62% more in contributions in Candid's research.</p>
            <span class="card-cta">Find Your Path to Platinum &rarr;</span>
          </a>
        </div>
        <p class="reveal" style="margin-top:1.25rem;"><a class="link-more" href="/tools">All free tools, including four deeper scores &rarr;</a> <span class="dim-sep" aria-hidden="true">&middot;</span> <a class="link-more" href="/insights">Research notes &rarr;</a></p>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section id="faq" class="section faq alt-bg">
      <div class="container narrow">
        <h2 class="section-title reveal">Common questions</h2>
        <div class="faq-list reveal">
          <details>
            <summary>Where does working together start?</summary>
            <p>With a free 30-minute conversation, then the InstitutionalOS Diagnostic: $2,000 for Build, $2,500 for Fund or Sustain. It's the single entry point for every paid engagement. <a href="/consulting#sample-diagnostic">See a sample report</a>.</p>
          </details>
          <details>
            <summary>We're not ready to pay for a diagnostic. Where should we start?</summary>
            <p>Take the <a href="/assessment">free 7-minute self-assessment</a>. Every tool you take after that adds to <a href="/health-index">your Health Index</a>, one profile you can print for your board.</p>
          </details>
          <details>
            <summary>Can a funder pay for the Diagnostic?</summary>
            <p>Often, yes. Many funders support capacity building, and a fixed price makes it an easy request. <a href="/consulting#funder-sponsored">Use the ready-made sponsorship letter</a>.</p>
          </details>
          <details>
            <summary>How do I make the case to my board?</summary>
            <p>Print your free <a href="/health-index">Health Index</a> for your next board meeting. Your board chair is welcome at the Diagnostic's readout session.</p>
          </details>
          <details>
            <summary>How are the free tools scored?</summary>
            <p>Every tool uses the same seven dimensions and the same evidence rubric, from "not in place" to "verified." Every question and its research source is on <a href="/methodology">How Scoring Works</a>.</p>
          </details>
        </div>
        <p class="reveal" style="margin-top:1rem;"><a class="link-more" href="/consulting#faq">More questions about working together &rarr;</a></p>
      </div>
    </section>

    <!-- ============ CONTACT ============ -->
    <section id="contact" class="section contact">
      <div class="container narrow">
        <h2 class="section-title reveal">Start a Conversation</h2>
        <div id="score-ref-banner" class="score-ref-banner reveal" hidden></div>
        <p class="lede-sm reveal">Strong missions need sustainable institutions. If your organization is navigating growth, revenue pressure, operational complexity, leadership transition, or the need for a clearer sustainability strategy, start with a conversation.</p>
        <p class="reveal">Tell me a little about your organization, where you are today, and what you're working to strengthen. I'll review your inquiry and follow up regarding whether Frankly Inspired may be a good fit.</p>

        <p class="direct-contact reveal">
          <a href="mailto:franklin@franklyinspired.associates">franklin@franklyinspired.associates</a>
          <span aria-hidden="true">&middot;</span>
          <a href="tel:+12403918283">240-391-8283</a>
        </p>

        <div class="schedule-cta schedule-cta-primary reveal">
          <p class="schedule-cta-label">Already know you'd like to talk?</p>
          <button type="button" class="btn btn-primary" id="show-scheduler" data-track="schedule_inline_open">See Available Times</button>
          <p class="scheduler-alt"><a href={CALENDLY_URL} target="_blank" rel="noopener" data-track="schedule_click">or open the scheduler in a new tab</a></p>
          <div id="scheduler" class="scheduler" hidden data-url={CALENDLY_URL}></div>
        </div>

        <p class="form-divider">Prefer to write it out first? Share a few details below and I'll follow up.</p>

        <!-- This form is live: posts to the frankly-inspired-backend
             /api/contact endpoint, which sends both the visitor's
             acknowledgement email and the internal lead-notification email.
             action="#" is inert on purpose; submission is handled entirely
             by the fetch call below, which calls preventDefault() first. -->
        <form class="contact-form" id="contact-form" action="#" method="POST" novalidate>
          <!-- Honeypot: real visitors never see or fill this in (see .hp-field
               in global.css). A filled value means a bot submitted the form. -->
          <div class="hp-field" aria-hidden="true">
            <label for="hp_field">Leave this field blank</label>
            <input type="text" id="hp_field" name="hp_field" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-row">
            <label for="name">Name*</label>
            <input type="text" id="name" name="name" placeholder="Your name" required />
          </div>
          <div class="form-row">
            <label for="organization">Organization*</label>
            <input type="text" id="organization" name="organization" placeholder="Organization name" required />
          </div>
          <div class="form-row">
            <label for="title">Title / Role</label>
            <input type="text" id="title" name="title" placeholder="Optional" />
          </div>
          <div class="form-row">
            <label for="email">Email*</label>
            <input type="email" id="email" name="email" placeholder="Email address" required />
          </div>
          <div class="form-row full">
            <label for="challenge">What challenge or opportunity are you currently navigating?*</label>
            <textarea id="challenge" name="challenge" rows="4" placeholder="A few sentences is plenty" required></textarea>
          </div>

          <details class="form-row full form-more">
          <summary>Add more details (optional)</summary>
          <div class="form-more-grid">
          <div class="form-row">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" placeholder="Optional" />
          </div>
          <div class="form-row">
            <label for="org-website">Organization Website</label>
            <input type="url" id="org-website" name="org_website" placeholder="Optional" />
          </div>

          <fieldset class="form-row full">
            <legend>How can I support your organization?</legend>
            <div class="checkbox-group">
              <label><input type="checkbox" name="support_area" value="InstitutionalOS Diagnostic" /> InstitutionalOS Diagnostic</label>
              <label><input type="checkbox" name="support_area" value="Advisory and Implementation Retainer" /> Advisory and Implementation Retainer</label>
              <label><input type="checkbox" name="support_area" value="Project Based Engagement" /> Project Based Engagement</label>
              <label><input type="checkbox" name="support_area" value="1:1 Executive Coaching" /> 1:1 Executive Coaching</label>
              <label><input type="checkbox" name="support_area" value="Speaking and Board Service" /> Speaking and Board Service</label>
              <label><input type="checkbox" name="support_area" value="Other" /> Other</label>
            </div>
          </fieldset>

          <fieldset class="form-row full">
            <legend>What is your desired timeline?</legend>
            <div class="radio-group">
              <label><input type="radio" name="timeline" value="As soon as possible" /> As soon as possible</label>
              <label><input type="radio" name="timeline" value="Within 30 days" /> Within 30 days</label>
              <label><input type="radio" name="timeline" value="Within 3 months" /> Within 3 months</label>
              <label><input type="radio" name="timeline" value="Within 6 months" /> Within 6 months</label>
              <label><input type="radio" name="timeline" value="Exploring options" /> Exploring options</label>
            </div>
          </fieldset>

          <div class="form-row full">
            <label for="referral">How did you hear about Frankly Inspired?</label>
            <input type="text" id="referral" name="referral" />
          </div>
          </div>
          </details>

          <p class="form-row full disclaimer">By submitting this form, you agree that Frankly Inspired and Associates, LLC may use the information provided to respond to your inquiry and communicate with you regarding potential services. Submitting this form does not create a consultant client relationship.</p>

          <button type="submit" class="btn btn-primary">Submit Inquiry</button>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>

        <!-- Client-side "thank you" state, shown after submit -->
        <div class="thank-you" id="thank-you" hidden>
          <h3>Thank you for reaching out.</h3>
          <p>Your inquiry has been received. I appreciate your interest in working with Frankly Inspired and Associates, LLC. I'll review the information you've provided and follow up regarding next steps.</p>
          <p>If you'd like to reserve time now, you can schedule a 30 minute introductory conversation below.</p>
          <div class="precall reveal-off">
            <p><strong>Before we talk (optional, about 15 minutes):</strong></p>
            <ol class="bullet-list">
              <li><a href="/assessment">Take the free 7-minute self-assessment</a> to build your Health Index.</li>
              <li>Have your latest filed Form 990, this year's budget, bylaws, and any strategic plan on hand.</li>
              <li><a href="/candid-seal">Check your Candid Seal path</a>.</li>
            </ol>
          </div>
          <a class="btn btn-secondary" href={CALENDLY_URL} target="_blank" rel="noopener">Schedule a Conversation &rarr;</a>
        </div>
      </div>
    </section>

  </main>

  <ScrollReveal />
</BaseLayout>

<script>
  // UPDATE THIS once frankly-inspired-backend is deployed to Render. See
  // that repo's README.md. Same value as assessment.astro's API_BASE.
  const API_BASE = 'https://frankly-inspired-api.onrender.com';

  // ---------- Old homepage anchors now live on /consulting ----------
  // Keeps every existing link working (scorecard, emails, tools, the
  // operations app): /consulting#pricing, /consulting#build, /consulting#pillar-revenue, and so on.
  (function forwardMovedAnchors() {
    const h = window.location.hash.replace('#', '');
    const moved = ['consulting', 'dimensions', 'pricing', 'build', 'fund', 'sustain', 'pricing-advisory', 'pricing-implementation', 'coaching', 'sample-diagnostic'];
    if (moved.includes(h) || h.startsWith('pillar-')) window.location.replace('/consulting#' + h);
  })();

  // ---------- Offer chosen on /consulting pre-checks the contact form ----------
  (function planFromQuery() {
    const plan = new URLSearchParams(window.location.search).get('plan');
    if (!plan) return;
    const box = document.querySelector<HTMLInputElement>(`input[name="support_area"][value="${CSS.escape(plan)}"]`);
    if (box) { box.checked = true; box.closest('details')?.setAttribute('open', ''); }
  })();

  // ---------- Score-ref handoff from the free InstitutionalOS scorecard ----------
  // A visitor who completes the free scorecard (grantpass-landing) and clicks
  // "Continue to a Conversation" arrives here with a signed score_ref token in
  // the URL (see auth.py's make_score_ref). This verifies it against the
  // backend, shows a short "continuing from your score" banner so they don't
  // have to re-explain themselves, and carries the raw token into the contact
  // form submission so Franklin sees the same context in the lead notification
  // email (see /api/contact + emailTemplates.js's contactNotificationEmail).
  let scoreRefToken: string | null = null;
  (function handleScoreRef() {
    const params = new URLSearchParams(window.location.search);
    const token = params.get('score_ref');
    if (!token) return;
    scoreRefToken = token;
    fetch(API_BASE + '/api/score-ref?token=' + encodeURIComponent(token))
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (!data || !data.ok) return;
        const banner = document.getElementById('score-ref-banner');
        if (!banner) return;
        const scoreText = data.score != null ? `${data.score}/100` : 'your result';
        const bandText = data.band ? ` (${data.band})` : '';
        banner.innerHTML = `<strong>Continuing from your ${data.stage || ''} scorecard:</strong> ${scoreText}${bandText}. No need to re-explain it below, I'll see it with your inquiry.`;
        banner.hidden = false;
      })
      .catch(() => {
        // A failed lookup (expired token, network hiccup) just means no
        // banner - the token still rides along with the form submission
        // below, and the backend re-verifies it independently there.
      });
  })();

  // ---------- Pricing card CTAs pre-check the matching service area ----------
  // data-plan accepts a comma-separated list, since a single retainer often
  // covers more than one service-area checkbox (e.g. the Implementation
  // Retainer's bullets span sustainability, revenue, operations, and
  // leadership, pre-checking just one box under-represented what someone
  // clicking it was actually signing up for).
  document.querySelectorAll<HTMLAnchorElement>('.plan-cta[data-plan]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const plans = (btn.getAttribute('data-plan') || '').split(',');
      plans.forEach((plan) => {
        const checkbox = document.querySelector<HTMLInputElement>(
          `input[name="support_area"][value="${plan.trim()}"]`
        );
        if (checkbox) {
          checkbox.checked = true;
          checkbox.closest('details')?.setAttribute('open', '');
        }
      });
    });
  });

  // ---------- Contact form ----------
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const thankYou = document.getElementById('thank-you');
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        organization: formData.get('organization'),
        // The backend requires a title, but it's optional on the form now.
        title: String(formData.get('title') || '').trim() || 'Not provided',
        email: formData.get('email'),
        phone: formData.get('phone'),
        org_website: formData.get('org_website'),
        // The backend requires at least one area; the boxes are optional on
        // the form now, so send a neutral value when none is checked.
        support_area: formData.getAll('support_area').length ? formData.getAll('support_area') : ['Not specified'],
        challenge: formData.get('challenge'),
        timeline: formData.get('timeline'),
        referral: formData.get('referral'),
        hp_field: formData.get('hp_field'),
        score_ref: scoreRefToken || undefined,
        // Stage (build/fund/sustain) the visitor picked in any free tool's
        // results, so the lead arrives in the operations app with the right
        // Diagnostic already attached.
        stage: (() => { try { return localStorage.getItem('fi_stage') || undefined; } catch { return undefined; } })(),
        trigger: (() => { try { return localStorage.getItem('fi_trigger') || undefined; } catch { return undefined; } })(),
      };

      if (status) status.textContent = 'Sending...';
      if (submitBtn) submitBtn.disabled = true;

      fetch(API_BASE + '/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then((res) => res.json().then((data) => ({ ok: res.ok, data })))
        .then((result) => {
          if (!result.ok || !result.data.ok) {
            throw new Error((result.data && result.data.error) || 'Something went wrong.');
          }
          if (status) status.textContent = '';
          (window as any).fiTrack?.('contact_form_submit');
          form.hidden = true;
          if (thankYou) thankYou.hidden = false;
        })
        .catch((err) => {
          if (status) status.textContent = err.message + ' You can also email franklin@franklyinspired.associates directly.';
        })
        .finally(() => {
          if (submitBtn) submitBtn.disabled = false;
        });
    });
  }

  // ---------- Inline scheduler ----------
  // Calendly's embed script only loads after the visitor asks for it, so
  // nobody gets third-party scripts or cookies just by visiting the page.
  (function inlineScheduler() {
    const btn = document.getElementById('show-scheduler');
    const box = document.getElementById('scheduler');
    if (!btn || !box) return;
    btn.addEventListener('click', () => {
      box.hidden = false;
      btn.hidden = true;
      const url = box.dataset.url || '';
      box.innerHTML = '<div class="calendly-inline-widget" data-url="' + url + '?hide_gdpr_banner=1" style="min-width:300px;height:700px;"></div>';
      const script = document.createElement('script');
      script.src = 'https://assets.calendly.com/assets/external/widget.js';
      script.async = true;
      document.body.appendChild(script);
    });
  })();

  // ---------- Live proof counter ----------
  // Shown only once the real total passes 25, so a small early number never
  // undercuts the page. Counts come from the backend; nothing per-visitor.
  fetch(API_BASE + '/api/stats')
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => {
      const n = d && typeof d.assessments === 'number' ? d.assessments : 0;
      if (n < 25) return;
      const el = document.getElementById('live-stat');
      const num = document.getElementById('live-stat-num');
      if (!el || !num) return;
      num.textContent = n.toLocaleString('en-US') + '+';
      el.hidden = false;
    })
    .catch(() => {});

</script>
