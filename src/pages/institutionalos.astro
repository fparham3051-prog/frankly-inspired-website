---
import Term from '../components/Term.astro';
import MarkDivider from '../components/MarkDivider.astro';
import { SCORECARD_URL, CALENDLY_URL } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

// The dedicated InstitutionalOS product page called for in Franklin's own
// Strategic Architecture doc (Section 12, "Suggested navigation" +
// "Recommended next steps" #7: "Create a dedicated InstitutionalOS product
// page and a Grant Pass FUND page"). Frankly Inspired stays the primary
// brand; this page introduces InstitutionalOS as the method and technology
// layer underneath the consulting practice, not a separate company - see
// Section 02, "The brand hierarchy."
//
// Content and structure follow that doc closely on purpose:
//   - Hero framing, the 5-step method (assess/verify/decide/improve/
//     reassess), and the closing CTA follow Section 12's "Homepage
//     narrative" and "Website language guardrails" (no overclaimed case
//     studies, no guaranteed-funding language, restrained/executive tone).
//   - The 7 dimensions and scoring rubric mirror Section 08, "Master
//     Health Index Engine."
//   - The decision-gate table uses the live language from scoring.py's
//     decision_band_for() (server.py / demo_scoring.py), not the earlier
//     draft wording in the architecture doc - so this page matches exactly
//     what a visitor sees on their own scorecard result, not a paraphrase.
//   - "Evidence discipline" follows Section 10 and links to the Evidence
//     Vault feature now live in the Console.
//   - The three response levels follow Section 11, "Software with a
//     service."
---

<BaseLayout
  title="InstitutionalOS | Frankly Inspired"
  description="InstitutionalOS scores a nonprofit on seven areas, checks the evidence behind each score, names the one gap that will break first, and tracks a 90-day plan to close it in a private workspace."
  footerVariant="about"
>
  <Header variant="full" />

  <main id="main">

    <!-- ============ HERO ============ -->
    <section class="assessment-intro">
      <div class="container narrow center">
        <p class="eyebrow eyebrow-dark reveal">How Frankly Inspired works</p>
        <h1 class="reveal">InstitutionalOS</h1>
        <p class="hero-sub-light reveal">The system behind every Frankly Inspired engagement. It scores your organization on seven areas, checks the evidence behind each score, names the one gap that will break first, and tracks a 90-day plan to close it, in a private workspace your team uses every week.</p>
        <div class="hero-ctas reveal" style="justify-content:center; display:flex; flex-wrap:wrap; gap:0.75rem; margin-top:0.5rem;">
          <a class="btn btn-primary" href="/assessment" data-track="tool_start" data-tool="institutionalos">Start the Free Check-up</a>
          <a class="btn btn-ghost" href={CALENDLY_URL} target="_blank" rel="noopener" style="border-color:rgba(255,255,255,0.4); color:#fff;">Schedule a Conversation</a>
        </div>
      </div>
    </section>

    <!-- ============ PRODUCT TOUR ============ -->
    <!-- Real InstitutionalOS client-portal screens, filled with a fictional
         sample organization (labeled as such). The "Explore" button opens the
         same portal in its read-only sample mode (report.html?demo=sample). -->
    <section class="section" id="inside">
      <div class="container">
        <h2 class="section-title reveal">See inside an InstitutionalOS workspace</h2>
        <p class="section-note reveal">Every client gets a private workspace that stays with them across the whole engagement: one record of their scores, the evidence behind them, the plan, and every check-in. Shown here with a sample organization.</p>
        <ol class="ios-tour">
          <li class="ios-step reveal">
            <div class="ios-step-text">
              <p class="ios-step-num">1 &middot; Assess</p>
              <h3>One <Term def="One score from 0 to 100 across the seven areas, weighted for your stage (Build, Fund, or Sustain).">Health Index</Term>, seven areas</h3>
              <p>The organization is scored 0 to 100 across direction, proof of results, revenue, leadership, operations, partnerships, and governance. The weakest area, the one most likely to break first, is flagged in red.</p>
            </div>
            <figure class="ios-shot"><img src="/assets/images/ios/t1-assess.webp" width="1600" height="625" loading="lazy" alt="Client portal header for a sample organization showing a Health Index of 54 on a seven-segment dial, with the weakest area in red" /></figure>
          </li>
          <li class="ios-step reveal">
            <div class="ios-step-text">
              <p class="ios-step-num">2 &middot; Verify</p>
              <h3>Every score shows what backs it</h3>
              <p>Each area carries the evidence behind its score: verified when a source document is attached, noted when it isn't, and flagged when nothing is on file yet. Scores without evidence are treated as assumptions.</p>
            </div>
            <figure class="ios-shot"><img src="/assets/images/ios/t3-evidence.webp" width="1600" height="1219" loading="lazy" alt="Evidence on file: each of seven areas with its score and a tag reading Verified, Noted, or No evidence on file" /></figure>
          </li>
          <li class="ios-step reveal">
            <div class="ios-step-text">
              <p class="ios-step-num">3 &middot; Decide</p>
              <h3>The one area to fix first</h3>
              <p>Each area gets a 90-day target. For your stage, a few areas have minimums that funders and boards expect, so you know what to fix first, even when the average looks fine.</p>
            </div>
            <figure class="ios-shot"><img src="/assets/images/ios/t2-dimensions.webp" width="1600" height="1489" loading="lazy" alt="Seven dimension bars with 90-day targets, and stage gates for governance, revenue, and proof of results" /></figure>
          </li>
          <li class="ios-step reveal">
            <div class="ios-step-text">
              <p class="ios-step-num">4 &middot; Act</p>
              <h3>A 90-day plan the team works in every week</h3>
              <p>Actions with owners, dates, and what counts as done. The team updates status and files a 15-minute weekly check-in in the same workspace, so blocked items surface right away.</p>
            </div>
            <figure class="ios-shot"><img src="/assets/images/ios/t4-plan.webp" width="1600" height="1066" loading="lazy" alt="A 90-Day Improvement Plan with six actions marked done, blocked, in progress, or not started" /></figure>
          </li>
          <li class="ios-step reveal">
            <div class="ios-step-text">
              <p class="ios-step-num">5 &middot; Review and reassess</p>
              <h3>Progress you can see over time</h3>
              <p>Every reassessment adds a point to the organization's history, so the board sees whether the work is moving the score, not just whether tasks got done.</p>
            </div>
            <figure class="ios-shot"><img src="/assets/images/ios/t5-progress.webp" width="1600" height="600" loading="lazy" alt="A progress chart showing a sample organization's Health Index rising across three reassessments from August to November" /></figure>
          </li>
          <li class="ios-step reveal">
            <div class="ios-step-text">
              <p class="ios-step-num">6 &middot; Before and after, ready for the board</p>
              <h3>What changed, on one page</h3>
              <p>Every area's score at the Diagnostic sits next to today's, so the change is plain to see. A two-page board report pulls it together: where you stand, what moved, the plan's progress, and the decisions ahead. <a href="/assets/docs/sample-board-report.pdf" target="_blank" rel="noopener" data-track="sample_board_report">See a sample board report (PDF)</a>.</p>
            </div>
            <figure class="ios-shot"><img src="/assets/images/ios/t6-before-after.webp" width="1600" height="857" loading="lazy" alt="Before and after table: each of seven areas with its score at the Diagnostic, today's score, and the change, all up between 2 and 8 points" /></figure>
          </li>
        </ol>
        <p class="ios-tour-note reveal">Sample organization with fictional data, shown in the real client portal. Your own workspace is private to your organization, opened by a link only your team holds.</p>
        <div class="hero-ctas reveal" style="justify-content:center; display:flex; flex-wrap:wrap; gap:0.75rem;">
          <a class="btn btn-primary" href="https://grantpass-dashboard.onrender.com/report.html?demo=sample" target="_blank" rel="noopener" data-track="sample_workspace_open">Explore the Sample Workspace</a>
          <a class="btn btn-secondary" href="/assessment" data-track="tool_start" data-tool="institutionalos-tour">Start the Free Check-up</a>
        </div>
      </div>
    </section>

    <MarkDivider step={3} />
    <!-- ============ THREE PATHWAYS ============ -->
    <section class="section" id="pathways">
      <div class="container">
        <h2 class="section-title reveal">One system, three lifecycle stages</h2>
        <p class="section-note reveal">Every organization is somewhere on this arc. InstitutionalOS asks a different core question at each stage, but scores all three against the same seven dimensions, so a score means the same thing no matter which stage it came from.</p>
        <div class="card-grid">
          <a class="card reveal" href="/consulting#build">
            <span class="offering-badge">Formation Readiness</span>
            <h3 class="h4-style">Build</h3>
            <p>Is the organization clear and structured enough to launch responsibly, covering governance, strategy, and the basics funders and boards look for from day one?</p>
            <span class="card-cta">See the price for this stage &rarr;</span>
          </a>
          <a class="card reveal" href="/consulting#fund">
            <span class="offering-badge">Grant Readiness</span>
            <h3 class="h4-style">Fund</h3>
            <p>Is the case for support, evidence, and financial picture strong enough for a specific funder to say yes, scored with your actual filed Form 990 data, not self-reported estimates.</p>
            <span class="card-cta">See the price for this stage &rarr;</span>
          </a>
          <a class="card reveal" href="/consulting#sustain">
            <span class="offering-badge">Institutional Durability</span>
            <h3 class="h4-style">Sustain</h3>
            <p>Is the institution resilient enough to keep performing without depending on any one grant, funder, or person, measured through financial resilience, leadership bench strength, and mature operations.</p>
            <span class="card-cta">See the price for this stage &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ HOW SCORING WORKS (short; detail lives on /methodology) ============ -->
    <section class="section alt-bg" id="scoring">
      <div class="container">
        <h2 class="section-title reveal">Scores you have to earn</h2>
        <div class="trust-grid reveal">
          <div class="trust-card"><h3 class="h4-style">Evidence, not confidence</h3><p>Each area is scored 0 to 100 on what you can show: an idea scores 25, something informal 50, documented and in use 75, routine and checked 100. A score with nothing behind it is treated as an assumption.</p></div>
          <div class="trust-card"><h3 class="h4-style">No hiding behind an average</h3><p>Each stage has a few areas that must clear a minimum on their own. A strong overall score can't make up for weak governance before a launch, or thin proof of results before a major grant.</p></div>
          <div class="trust-card"><h3 class="h4-style">A target you can reach</h3><p>The 90-day target closes a quarter of the gap: an area at 44 aims for 58. Financial health comes straight from your filed Form 990s, not estimates. Every score is rechecked at six months.</p></div>
        </div>
        <p class="section-note reveal" style="margin-top:1.25rem;">Every question, the full rubric, and how the overall score reads are on <a href="/methodology">How Scoring Works</a>.</p>
      </div>
    </section>

    <MarkDivider step={6} />
    <!-- ============ HOW IT DIFFERS ============ -->
    <section class="section" id="compare">
      <div class="container">
        <h2 class="section-title reveal">How InstitutionalOS differs from what you've tried</h2>
        <p class="section-note reveal">Most leaders have been through at least one of these. Each is useful for its own job. InstitutionalOS does a narrower one: find the single gap that will break first, prove it with evidence, and close it in 90 days.</p>
        <div class="org-table-wrap reveal" tabindex="0" role="region" aria-label="Comparison with other approaches"><table class="org-table compare-table">
          <thead><tr><th>Approach</th><th>What it's good for</th><th>Where InstitutionalOS is different</th></tr></thead>
          <tbody>
            <tr><td><strong>Strategic planning</strong></td><td>Agreeing where the organization is headed over three to five years.</td><td>Starts from what's in the way now, not where you want to be. Four weeks to a decision, not six months to a document. Often the step that makes a strategic plan doable.</td></tr>
            <tr><td><strong>Organizational assessments</strong> (capacity tools, consultant reviews)</td><td>A broad picture of strengths and weaknesses across many areas.</td><td>Ends in one named constraint and a 90-day plan, not a long list of findings. Scores rest on evidence you can show, not self-ratings. Reassessed at six months, so progress is measured.</td></tr>
            <tr><td><strong>EOS (Entrepreneurial Operating System)</strong></td><td>A management rhythm for for-profit leadership teams: quarterly priorities, weekly meetings, a scorecard.</td><td>Built for nonprofits, where boards, funders, Form 990s, and restricted money change what "healthy" means. Uses a similar weekly rhythm, but the priority is chosen from a scored diagnosis, not by the team's vote.</td></tr>
            <tr><td><strong>Balanced scorecards</strong></td><td>Tracking performance across finance, customers, process, and learning once goals are set.</td><td>Tells you which measure matters most right now and why. The seven dimensions are scored against stage benchmarks, and financial health comes from your filed 990s.</td></tr>
            <tr><td><strong>Generic capacity building</strong> (trainings, cohorts, coaching)</td><td>Building skills across staff and leaders.</td><td>Targets the one gap holding everything else back, with named owners, dates, and evidence that it closed. Capacity building can follow, aimed where it will count.</td></tr>
          </tbody>
        </table></div>
        <p class="section-note reveal">Already in a strategic plan or using EOS? InstitutionalOS works alongside both. The Diagnostic tells you which part of the plan to protect first.</p>
      </div>
    </section>

    <!-- ============ CLOSING CTA ============ -->
    <section class="section closing-cta">
      <div class="container narrow center">
        <h2 class="reveal">Clear enough to launch. Strong enough to fund. Disciplined enough to endure.</h2>
        <p class="reveal">Start with the free check-up, or talk it through if you already know the decision in front of you. The Diagnostic is $2,000 to $2,500, flat.</p>
        <div class="reveal" style="display:flex; flex-wrap:wrap; gap:0.75rem; justify-content:center;">
          <a class="btn btn-primary" href="/assessment" data-track="tool_start" data-tool="institutionalos">Start the Free Check-up</a>
          <a class="btn btn-ghost" href={CALENDLY_URL} target="_blank" rel="noopener" style="border-color:rgba(255,255,255,0.4); color:#fff;">Schedule a Conversation</a>
        </div>
        <p style="margin-top: 1rem;"><a class="link-more" href="/consulting#pricing">See services and pricing</a></p>
      </div>
    </section>

  </main>

  <ScrollReveal />
</BaseLayout>

<style>
  .ios-tour { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 3.5rem; }
  .ios-step { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 2.5rem; align-items: center; }
  .ios-step:nth-child(even) .ios-step-text { order: 2; }
  .ios-step-num { margin: 0 0 0.4rem; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold-accessible); }
  .ios-step h3 { margin: 0 0 0.6rem; font-family: var(--font-heading); color: var(--navy); font-size: 1.45rem; line-height: 1.25; }
  .ios-step-text p:last-child { margin: 0; color: #4a535c; line-height: 1.6; }
  .ios-shot { margin: 0; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); box-shadow: var(--shadow-lg); background: #f3f4f6; max-height: 520px; }
  .ios-shot img { display: block; width: 100%; height: auto; }
  .ios-tour-note { text-align: center; font-size: 0.85rem; color: #5b6570; margin: 2.5rem 0 1.25rem; }
  @media (max-width: 820px) {
    .ios-step { grid-template-columns: 1fr; gap: 1.25rem; }
    .ios-step:nth-child(even) .ios-step-text { order: 0; }
    .ios-shot { max-height: 420px; }
  }
</style>
