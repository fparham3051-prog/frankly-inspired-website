---
// "Email me my results" for any free tool. The tool page stores its latest
// results on window.__fiLastResults (see each page's fetchNarrative); this
// form sends them to the backend, which emails the visitor and adds the
// lead to the operations app.
interface Props { id: string }
const { id } = Astro.props;
---

<form class="results-email-form" id={id} data-email-results novalidate>
  <div class="hp-field" aria-hidden="true">
    <label for={`${id}-hp`}>Leave this field blank</label>
    <input type="text" id={`${id}-hp`} name="hp_field" tabindex="-1" autocomplete="off" />
  </div>
  <label for={`${id}-email`}>Want these results emailed to you?</label>
  <div class="results-email-row">
    <input type="email" id={`${id}-email`} name="email" placeholder="Email address" required />
    <button type="submit" class="btn btn-secondary">Email My Results</button>
  </div>
  <label class="results-email-remind"><input type="checkbox" name="remind" value="1" /> Also send me one reminder in 90 days to re-check my progress</label>
  <p class="results-email-consent">Franklin may follow up personally about your results. No mailing list; a reminder is sent once, then your address is deleted.</p>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<script>
  import { loadProfile, sealSummary } from '../scripts/healthEngine';
  import { TOOLS } from '../data/questionBank';
  const API_BASE = 'https://frankly-inspired-api.onrender.com';
  document.querySelectorAll<HTMLFormElement>('form[data-email-results]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form-status');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const results = (window as any).__fiLastResults;
      if (!results) {
        if (status) status.textContent = 'See your results first, then send them.';
        return;
      }
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const fd = new FormData(form);
      const profile = loadProfile();
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (status) status.textContent = 'Sending...';
      if (btn) btn.disabled = true;
      fetch(API_BASE + '/api/assessment-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: fd.get('email'),
          hp_field: fd.get('hp_field'),
          tool: results.tool,
          stage: (() => { try { return localStorage.getItem('fi_stage') || undefined; } catch { return undefined; } })(),
          scorePct: results.scorePct,
          band: results.band,
          pillarScores: results.pillarScores,
          narrative: results.narrative || null,
          org: profile.org || undefined,
          toolsTaken: Object.keys(profile.tools).map((k) => TOOLS.find((t) => t.key === k)?.name || k),
          seal: (() => { const s = sealSummary(profile); return s ? { current: s.current, next: s.next } : undefined; })(),
          remind: fd.get('remind') === '1',
        }),
      })
        .then((res) => res.json().then((data) => ({ ok: res.ok, data })))
        .then((r) => {
          if (!r.ok || !r.data.ok) throw new Error((r.data && r.data.error) || 'Something went wrong.');
          if (status) {
            status.textContent = r.data.reminder ? 'Sent, check your inbox. Your 90-day reminder is set. ' : 'Sent, check your inbox.';
            if (r.data.cancelUrl) {
              const a = document.createElement('a');
              a.href = r.data.cancelUrl; a.textContent = 'Cancel the reminder'; a.target = '_blank'; a.rel = 'noopener';
              status.appendChild(a);
            }
          }
          (window as any).fiTrack?.('results_emailed', { tool: results.tool });
          form.reset();
        })
        .catch((err) => { if (status) status.textContent = err.message; })
        .finally(() => { if (btn) btn.disabled = false; });
    });
  });
</script>
