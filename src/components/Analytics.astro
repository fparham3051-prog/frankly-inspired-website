---
// Consent-gated Google Analytics loader.
//
// NOTE: Google Analytics is not live yet. This is the on/off switch for
// when it is. Replace GA_MEASUREMENT_ID below with the real "G-XXXXXXXXXX"
// ID from Google Analytics and analytics will start loading automatically,
// but ONLY for visitors who click "Accept" on the cookie banner
// (CookieConsentBanner.astro). Nobody who declines, or hasn't answered yet,
// gets a tracking script loaded. Leave the ID blank and this does nothing.
const GA_MEASUREMENT_ID = ''; // e.g. 'G-XXXXXXXXXX'
---

<script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
  (function () {
    function loadGoogleAnalytics() {
      if (!GA_MEASUREMENT_ID || window.__fiAnalyticsLoaded) return;
      window.__fiAnalyticsLoaded = true;

      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      // anonymize_ip retained for visitor privacy even with consent granted.
      gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });
    }

    function init() {
      if (!window.cookieConsent) return; // cookie-consent script must load first

      if (window.cookieConsent.get() === 'accepted') {
        loadGoogleAnalytics();
      }

      document.addEventListener(window.cookieConsent.CHANGE_EVENT, (e) => {
        if (e.detail && e.detail.consent === 'accepted') {
          loadGoogleAnalytics();
        }
        // Note: GA's own script, once loaded, can't be unloaded mid-session if
        // a visitor accepts then later declines. It simply won't be
        // (re)loaded on their next visit if they've since declined.
      });
    }

    // ---------- Conversion events ----------
    // fiTrack sends an event to Google Analytics only if GA has loaded
    // (i.e. an ID is set above AND the visitor accepted cookies);
    // otherwise it does nothing. Any link or button with data-track="name"
    // is tracked automatically on click, and every tool form submit is
    // tracked as tool_complete.
    // Cookie-free counting for the funnel in the operations app: page and
    // event name only, no cookies, no IP stored, no visitor ID. Runs for
    // everyone because nothing in it identifies a person.
    var PV_URL = 'https://frankly-inspired-api.onrender.com/api/pv';
    function count(e) {
      try {
        var body = JSON.stringify({ p: location.pathname, e: e || 'view' });
        if (navigator.sendBeacon) navigator.sendBeacon(PV_URL, body);
        else fetch(PV_URL, { method: 'POST', body: body, keepalive: true, mode: 'cors' });
      } catch (err) {}
    }
    if (!/^(localhost|127\.)/.test(location.hostname)) count('view');
    window.fiTrack = function (name, params) {
      if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
      if (['tool_start', 'tool_complete', 'schedule_click', 'schedule_inline_open', 'contact_submit'].indexOf(name) >= 0 && !/^(localhost|127\.)/.test(location.hostname)) count(name);
    };
    document.addEventListener('click', function (e) {
      var el = e.target && e.target.closest ? e.target.closest('[data-track]') : null;
      if (el) window.fiTrack(el.getAttribute('data-track'), { page: location.pathname, tool: el.getAttribute('data-tool') || undefined });
      var a = e.target && e.target.closest ? e.target.closest('a[href*="calendly.com"]') : null;
      if (a && !a.hasAttribute('data-track')) window.fiTrack('schedule_click', { page: location.pathname });
    });
    document.addEventListener('submit', function (e) {
      var f = e.target;
      if (f && f.id && f.id !== 'contact-form') window.fiTrack('tool_complete', { page: location.pathname, form: f.id });
    }, true);

    document.addEventListener('DOMContentLoaded', init);
  })();
</script>
